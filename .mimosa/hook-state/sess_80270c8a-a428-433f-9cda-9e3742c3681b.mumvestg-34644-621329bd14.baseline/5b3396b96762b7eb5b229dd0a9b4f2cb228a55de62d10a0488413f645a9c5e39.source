interface DevResult {
  /** 模块名（用任务里指定的名称） */
  module: string;
  /** 写出/修改的文件 */
  files: string[];
  /** 自测结论一句话：跑了什么、结果如何 */
  selfTest: string;
  /** 未解决问题 */
  openIssues: string[];
}

interface RealRunResult {
  /** 完成的完整真实运行次数 */
  runs: number;
  /** 产出目录 */
  outputDir: string;
  /** API usage 汇总（prompt_tokens/completion_tokens 总和，来自响应 usage 字段） */
  usageSummary: string;
  /** 单次完整运行墙钟秒数（最后一次） */
  wallSeconds: number;
  /** 修复过的真实环境问题清单 */
  issuesFixed: string[];
  /** 未解决问题 */
  openIssues: string[];
}

interface ModelVerdict {
  /** 模型 id */
  model: string;
  /** 结构合法率（JSON 可解析且过 schema 校验的比例） */
  structurePass: string;
  /** 与黄金夹具的取值一致性观察 */
  faithfulness: string;
  /** 时延与用量观察 */
  latencyUsage: string;
  /** 结论：适合什么角色 */
  verdict: string;
}

interface ComparisonResult {
  candidates: ModelVerdict[];
  /** 推荐的默认抽取模型（写入 config.example.json 的那个） */
  recommendedExtractor: string;
  /** 是否已更新 config.example.json */
  configUpdated: boolean;
  /** 总 usage 汇总 */
  usageSummary: string;
}

interface PackageResult {
  /** ZIP 路径（workspace 相对） */
  zipPath: string;
  /** ZIP 大小 MB */
  zipMB: string;
  /** 包内文件数 */
  fileCount: number;
  /** 自检结论（--version、mock e2e 从包内布局实跑的结果） */
  selfTest: string;
  /** 警告（如未包含的东西） */
  warnings: string[];
}

interface AuditFinding {
  /** 问题位置：文件路径，可带 :行号 */
  where: string;
  /** 一句话说清问题本身 */
  what: string;
  /** 证据：读到的代码或输出片段 */
  evidence: string;
  /** low=规范瑕疵；medium=会影响得分；high=会导致失败或错误结果 */
  severity: "low" | "medium" | "high";
  /** 一句话修复建议 */
  suggestion: string;
}

interface AuditResult {
  findings: AuditFinding[];
  /** 整体评估一句话 */
  overall: string;
}

interface FixAck {
  fixed: string[];
  notFixed: string[];
}

interface Finding {
  where: string;
  what: string;
  evidence: string;
  status: "verified" | "unconfirmed";
  severity: "low" | "medium" | "high";
}

interface WorkflowReport {
  conclusion: string;
  findings: Finding[];
  verified: string[];
  notCovered: string[];
}

const COMMON = [
  "项目：千问AI Arena「消费决策好帮手：智能选购顾问」参赛 Agent，第二阶段（真实模型联调与打包）。工作区即当前目录（D:\\workspace\\qw-arena2）。",
  "必读：SPEC.md、AGENTS.md、contracts/、reports/progress.md（第一阶段已交付 mock 端到端基线，345 测试全过）。",
  "API 凭据已就绪：Key 在 .secrets/dashscope_api_key.txt，网关地址在 .secrets/base_url.txt（https://maas.qianwenaiapi.com/compatible-mode/v1，OpenAI 兼容）。16 个白名单模型已探测全部可用。",
  "真实网关行为要点（已实测）：响应含独立 reasoning_content（思考）字段，答案在 content；若显式限制 max_tokens 过小，思考会耗尽 token 导致 content 为空、finish_reason=length。默认不传 max_tokens 即可，但必须对「content 为空/finish_reason=length」给出清晰错误与一次重试。",
  "费用纪律：本阶段测试预算合计不超过 20 元；每次真实调用后记录响应 usage 的 prompt/completion tokens 并汇总；绝不打印 Key；任何单次完整运行 usage 超过 200 万 tokens 立即停止并升级提问。",
  "纪律：只改分配给你的文件；不删测试不改真值；mock 测试必须保持全过；遇到无法自行解决的关键阻塞用升级机制提问。",
].join("\n");

const FIXER_PROMPT = `${COMMON}

你是修复工程师。负责两块：第一阶段审计遗留的 5 项低级发现 + 真实网关校准。可修改：src/（除 pipeline.py 的主链结构外均可）、prompts/、tools/evaluate.py、tests/ 对应文件。

一、审计遗留修复（原发现摘录）：
1. tools/evaluate.py:144 未重建有效集 E，「推荐∈E」只在 pipeline 内部生效——请让评估器用 constraint_engine 以相同输入独立重建 E 并校验（或给出不改契约的最小方案并说明理由）。
2. src/selector.py:604 「无足够新增价值」分支的条件句模板例举「（如价格最低、形态不同）」与详情自相矛盾——条件句必须由该产品实际属性生成，删掉固定例举。
3. src/selector.py:754 综合结论未按官方句面给「偏好取向→选哪款」映射——按入选三款的真实差异字段生成取向映射句。
4. prompts/profile_extraction.md 与 prompts/product_extraction.md 的输出示例内嵌 User_Description_1/P001 真实取值且每次原样发送（示例值污染）——把示例改成与任何真实输入无关的占位值（明显虚构的品牌/型号/数字），或改为结构说明+字段级格式约束，保证模型无法从示例直接抄值。
5. src/pipeline.py:466 修复循环 targets 含「资料确无」的非必填字段缺口——重查目标只保留 field_catalog 中标必须的字段缺口，非必填缺口登记日志但不触发重查。

二、网关校准（src/model_gateway.py）：
- 默认不发送 max_tokens；对 content 为空且 finish_reason=length 的响应抛清晰错误（含模型名与 finish_reason），由 chat_json 路径做一次降级重试（重试时明确要求直接输出 JSON、不要长思考——可在重试 messages 前加一句指令）。
- usage 字段（prompt_tokens/completion_tokens）透传并累计到网关实例（供工具汇总成本），日志只记 token 数不记内容。
- 以上全部先在 mock/fake 测试里覆盖（fake session 注入空 content/length 响应），再动真实调用。

完成后：python -m pytest tests -q 必须全过（不许删改任何既有测试；新增测试补齐上述行为）。返回 DevResult（module 填「审计修复与网关校准」）。`;

const REAL_PROMPT = `${COMMON}

你是联调工程师，负责让 pipeline 在真实模型上端到端跑通。可修改：tools/e2e_real.py（新建）、src/pipeline.py、src/ 下抽取相关模块的小修（大改需在 openIssues 登记）、reports/progress.md。不许改 contracts/、SPEC.md、不许动 mock 测试语义。

任务：
1. 新建 tools/e2e_real.py：读 .secrets/dashscope_api_key.txt 与 .secrets/base_url.txt（若环境变量已设则优先环境变量），对 raw/dataset_sample/Data_for_Users 运行 agent/agent.py --prompt（子进程注入 DASHSCOPE_API_KEY/OPENAI_BASE_URL 环境变量），输出到 reports/e2e_real_output/，随后调 tools/evaluate.py 校验；打印各阶段耗时与 usage 汇总；按结果退出 0/1。这是本地工具，绝不打进提交包。
2. 默认模型用 config.example.json 的 qwen3.6-plus，实测完整跑一遍。预期问题（都可能遇到）：真实模型 JSON 里多余文字/嵌套错位、evidence_refs 造得不在真实 span 上、字段缺失触发修复循环、限流。逐个修到 evaluate 全过。
3. 修复原则：优先改提示词与解析校验，其次改重试逻辑；不改 mock 夹具真值；每次修复后重跑 e2e_real 验证。完整真实运行总数控制在 6 次以内（费用约束），每次记录 usage。
4. 抽查产出：user_profile.md/product_list.md/recommendation.md 各读一遍，对照 raw 数据抽查 5 个取值可回溯性；发现抽取质量问题（漏项/编造）记录到 openIssues（第二阶段不要求完美，但不能有编造）。
5. reports/progress.md 追加运行记录（次数/tokens/耗时/问题）。

返回 RealRunResult。`;

const BENCH_PROMPT = `${COMMON}

你是选型评估员。任务：用同一输入对比 3 个候选模型的抽取质量，选出默认抽取模型并更新 config.example.json。可修改：tools/benchmark.py（新建）、config.example.json、reports/model_comparison.md（新建）、reports/progress.md。不许改 src/ 的抽取语义（若发现必须改的先登记 openIssues）。

候选：qwen3.6-plus（现任默认）、qwen3.7-max（旗舰）、deepseek-v4-flash（廉价档）。
基准输入：raw/dataset_sample 的 User_Description_1 与 P001..P005；黄金参照：tests/fixtures/gateway/responses.json 里 profile:user_1 与 products:P001..P005 键（第一阶段逐字核对过原文的忠实抽取，当参照真值用）。

方法：
1. tools/benchmark.py：对每个候选模型跑画像抽取 1 次 + 产品抽取 5 次（同 prompts、同输入），记录结构合法率（JSON 可解析+过 schema 校验）、与黄金夹具的字段级一致率（自动比对：字段存在性、关键数值/枚举相等或等价区间、evidence_refs 是否指向正确 source）、单调用延迟、usage。
2. 对比表写进 reports/model_comparison.md：三模型 × （结构/忠实度/延迟/成本）+ 结论；结论要落到「默认抽取模型用哪个、什么情况下值得切旗舰、flash 档是否能用于非关键字段」。
3. 把胜者写入 config.example.json 的默认模型字段（只动这一个模型相关字段）。
4. 总调用量 ≤ 18 次抽取调用 + 必要重试；usage 汇总进报告。

返回 ComparisonResult（含每个模型的 structurePass/faithfulness/latencyUsage/verdict 文字结论）。`;

const PACKAGE_PROMPT = `${COMMON}

你是打包工程师。任务：产出可提交的 ZIP。可修改：tools/package.py（新建）、tools/e2e_mock_packaged.py（新建）、agent/、reports/progress.md。不许改 src/ 语义、contracts/、SPEC.md。

打包要求（官方规则，见 SPEC §2 与 raw/Agent本地验证指南.md）：
1. tools/package.py：组装 dist/agent/ 目录——agent.py 在根，src/、prompts/、运行所需 contracts/、agent.json、requirements.txt、lib/（pip install --platform manylinux2014_x86_64 --python-version 3.12 --target dist/agent/lib --only-binary=:all: requests 的产物）全部就位；agent.py 的 sys.path 处理让包内布局可用（当前 agent/agent.py 依赖仓库根 src/，包内必须自洽）；排除 .secrets/、reports/、raw/、tests/、tools/；然后 zip 成 dist/agent.zip，校验 ≤100MB 并打印大小与文件数。
2. 结构自检（Docker 本机没有，官方校验工具跑不了，用这三项替代）：python dist/agent/agent.py --version 输出 0.1.0 退出码 0；tools/e2e_mock_packaged.py（设 QW_FORCE_MOCK=1，对示例数据跑 dist/agent/agent.py --prompt 输出到 reports/e2e_packaged_output/ 并校验，退出 0/1）；zip 解包到临时目录后重跑上述两项（验证 zip 本身自洽）。
3. 包内不得含任何密钥、.secrets、绝对路径依赖；agent.json 版本与 --version 一致。
4. reports/progress.md 登记打包结果。

完成后亲自把三项自检都跑过。返回 PackageResult。`;

const AUDIT_PROMPT = `${COMMON}

你是独立审计员，用新鲜视角做提交前审查。**不许编辑任何文件**。

审查对象：dist/agent/ 目录与 dist/agent.zip（解包列表即可，不必解包）、tools/package.py、tools/e2e_real.py、tools/benchmark.py、reports/e2e_real_output/ 下三份真实产出、reports/model_comparison.md、config.example.json、src/ 本阶段改动（git 不可用，以 reports/progress.md 登记为线索）。对照：SPEC.md、raw/competition-problemData.txt、raw/Agent本地验证指南.md。

逐项核查：
(a) 提交包合规：ZIP≤100MB、入口 agent.py 在根、agent.json 合法、依赖全打包（lib/ 内 manylinux 轮子齐全，无 .secrets/raw/reports 泄漏、无 Windows 路径硬编码）；
(b) 真实产出抽查：reports/e2e_real_output/ 三份文档对照 raw 数据抽 8 个取值，验证可回溯、无编造；evidence 指向的 source 存在；
(c) 模型选型报告的结论是否被数据支撑（对比表数字与结论一致，没有「数据平手但硬推旗舰」之类）；
(d) 5 项审计遗留是否真修（对照第一阶段发现清单：evaluate 重建 E、条件句模板、综合结论映射、示例值污染、修复循环目标过滤）——逐项给证据；
(e) config.example.json 默认模型与选型结论一致；
(f) 密钥卫生：grep dist/ 与 src/ 确认无 sk- 开头字符串。

只报真问题（where/what/evidence/severity/suggestion）；没有就返回空 findings，不凑数。overall 给一句「可以提交/不建议提交+原因」。`;

artifact.board("p2-board", {
  title: "第二阶段进度",
  key: "module",
  status: "status",
  columns: ["进行中", "已完成", "有问题"],
  cardTitle: "module",
  detail: [{ field: "selfTest", label: "状态" }],
});

phase("修复审计遗留并校准真实网关");
report({ module: "审计修复与网关校准", status: "进行中", selfTest: "-" }, "p2-board");
const fixer = agent("修复工程师", { system: "你是严谨的修复工程师：每项修复都有测试兜底，修不动就升级，绝不糊弄。" });
const fixRes = await fixer.ask<DevResult>(FIXER_PROMPT);
const fixGate = await world.run("python", ["-m", "pytest", "tests", "-q", "--tb=short"], { timeoutMs: 600000 });
if (fixGate.exitCode !== 0) {
  await fixer.ask(`修复后全量测试失败，请处理（不许删测试）：\n${(fixGate.stdout + "\n" + fixGate.stderr).slice(-5000)}`);
}
report({ module: "审计修复与网关校准", status: fixGate.exitCode === 0 ? "已完成" : "有问题", selfTest: fixRes.selfTest.slice(0, 200) }, "p2-board");

phase("真实端到端联调（消耗 API 额度）");
report({ module: "真实端到端联调", status: "进行中", selfTest: "真实模型实测中" }, "p2-board");
const realist = agent("联调工程师", { system: "你是实战联调工程师：真实模型的问题逐个击破，费用敏感，每次运行都要有 usage 记录；修不动就升级。" });
const realRes = await realist.ask<RealRunResult>(REAL_PROMPT);
let realGate = await world.run("python", ["tools/e2e_real.py"], { timeoutMs: 1800000 });
if (realGate.exitCode !== 0) {
  await realist.ask(`门禁复跑 tools/e2e_real.py 失败（退出码 ${realGate.exitCode}），这是最后一次修复机会，只修导致失败的问题：\n${(realGate.stdout + "\n" + realGate.stderr).slice(-6000)}`);
  realGate = await world.run("python", ["tools/e2e_real.py"], { timeoutMs: 1800000 });
}
const realOk = realGate.exitCode === 0;
report({ module: "真实端到端联调", status: realOk ? "已完成" : "有问题", selfTest: `${realRes.runs} 次真实运行，${realRes.usageSummary}` }, "p2-board");
log(`真实联调${realOk ? "通过" : "未通过"}：${realRes.runs} 次运行，usage ${realRes.usageSummary}，末次 ${realRes.wallSeconds}s`);

phase("模型选型对比（消耗 API 额度）");
report({ module: "模型选型", status: "进行中", selfTest: "3 模型对比中" }, "p2-board");
const benchmarker = agent("选型评估员", { system: "你是量化选型评估员：结论必须由对比数据支撑，平手就直说平手；费用敏感。" });
const benchRes = await benchmarker.ask<ComparisonResult>(BENCH_PROMPT);
report({ module: "模型选型", status: "已完成", selfTest: `默认抽取模型→${benchRes.recommendedExtractor}` }, "p2-board");
log(`选型完成：默认抽取模型 ${benchRes.recommendedExtractor}，总 usage ${benchRes.usageSummary}`);

phase("打包提交物并自检");
report({ module: "打包", status: "进行中", selfTest: "-" }, "p2-board");
const packager = agent("打包工程师", { system: "你是发布工程师：包必须自洽、合规、可复现，绝不含密钥；自检跑不过就不许说完成。" });
const packRes = await packager.ask<PackageResult>(PACKAGE_PROMPT);
let pkgVer = await world.run("python", ["dist/agent/agent.py", "--version"], { timeoutMs: 120000 });
let pkgE2e = pkgVer.exitCode === 0 ? await world.run("python", ["tools/e2e_mock_packaged.py"], { timeoutMs: 900000 }) : { exitCode: pkgVer.exitCode, stdout: pkgVer.stdout, stderr: pkgVer.stderr };
if (pkgVer.exitCode !== 0 || pkgE2e.exitCode !== 0) {
  await packager.ask(`包自检失败（--version=${pkgVer.exitCode}，packaged e2e=${pkgE2e.exitCode}），请修复：\n${(pkgVer.stdout + "\n" + pkgVer.stderr + "\n" + pkgE2e.stdout + "\n" + pkgE2e.stderr).slice(-6000)}`);
  pkgVer = await world.run("python", ["dist/agent/agent.py", "--version"], { timeoutMs: 120000 });
  pkgE2e = await world.run("python", ["tools/e2e_mock_packaged.py"], { timeoutMs: 900000 });
}
const pkgOk = pkgVer.exitCode === 0 && pkgE2e.exitCode === 0;
report({ module: "打包", status: pkgOk ? "已完成" : "有问题", selfTest: `${packRes.zipPath} ${packRes.zipMB}MB` }, "p2-board");

phase("全量回归门禁");
const finalUnit = await world.run("python", ["-m", "pytest", "tests", "-q", "--tb=short"], { timeoutMs: 600000 });
const finalMock = await world.run("python", ["tools/e2e_mock.py"], { timeoutMs: 900000 });
let allGreen = finalUnit.exitCode === 0 && finalMock.exitCode === 0 && realOk && pkgOk;
if (!allGreen && (finalUnit.exitCode !== 0 || finalMock.exitCode !== 0)) {
  await fixer.ask(`最终回归失败（pytest=${finalUnit.exitCode}，e2e_mock=${finalMock.exitCode}），最后修复机会：\n${(finalUnit.stdout + "\n" + finalUnit.stderr + "\n" + finalMock.stdout + "\n" + finalMock.stderr).slice(-5000)}`);
  const rerunUnit = await world.run("python", ["-m", "pytest", "tests", "-q"], { timeoutMs: 600000 });
  const rerunMock = await world.run("python", ["tools/e2e_mock.py"], { timeoutMs: 900000 });
  allGreen = rerunUnit.exitCode === 0 && rerunMock.exitCode === 0 && realOk && pkgOk;
}
report({ module: "最终门禁", status: allGreen ? "已完成" : "有问题", selfTest: allGreen ? "pytest+mock+real+packaged 全过" : "存在未过项" }, "p2-board");

phase("独立审计提交包与真实输出");
report({ module: "独立审计", status: "进行中", selfTest: "-" }, "p2-board");
const auditor = agent("独立审计员", { system: "你是没参与开发的独立审计员：只读不改，逐条对照官方规则找真问题；凑数式发现比没有更糟；结论必须明确「可以提交/不建议提交」。" });
const audit = await auditor.ask<AuditResult>(AUDIT_PROMPT);
report({ module: "独立审计", status: "已完成", selfTest: `${audit.findings.length} 项发现：${audit.overall.slice(0, 60)}` }, "p2-board");
log(`审计完成：${audit.findings.length} 项发现（high ${audit.findings.filter(f => f.severity === "high").length} / medium ${audit.findings.filter(f => f.severity === "medium").length} / low ${audit.findings.filter(f => f.severity === "low").length}）。总评：${audit.overall}`);
const fixables = audit.findings.filter(f => f.severity === "high" || f.severity === "medium");
let fixAck: FixAck = { fixed: [], notFixed: [] };
if (fixables.length > 0) {
  const routing = fixables.map(f => `- [${f.severity}] ${f.where}: ${f.what}（建议：${f.suggestion}）`).join("\n");
  fixAck = await fixer.ask<FixAck>(`提交前审计发现以下问题，请修复（不许删测试；确属误报放 notFixed 写明理由）。打包相关改动后需让打包工程师重新打 ZIP 的话，直接改 tools/package.py 与 agent/ 布局后运行 python tools/package.py 重建，并重跑 dist/agent/agent.py --version 与 python tools/e2e_mock_packaged.py 确认：\n${routing}`);
  const regateUnit = await world.run("python", ["-m", "pytest", "tests", "-q"], { timeoutMs: 600000 });
  const regatePkg = await world.run("python", ["tools/e2e_mock_packaged.py"], { timeoutMs: 900000 });
  allGreen = allGreen && regateUnit.exitCode === 0 && regatePkg.exitCode === 0;
}

const findingsOut: Finding[] = audit.findings.map(f => ({
  where: f.where,
  what: f.what,
  evidence: f.evidence,
  severity: f.severity,
  status: fixAck.fixed.some(x => f.where.includes(x) || x.includes(f.where.split(":")[0])) ? "verified" : "unconfirmed",
}));

const verified: string[] = [
  "python -m pytest tests -q 全量（修复后最终一次退出码 0）",
  `python tools/e2e_real.py 真实模型端到端（${realRes.runs} 次真实运行，usage ${realRes.usageSummary}，末次 ${realRes.wallSeconds}s）`,
  `python dist/agent/agent.py --version 与 python tools/e2e_mock_packaged.py 包内自检（${packRes.zipPath}，${packRes.zipMB}MB）`,
  "python tools/e2e_mock.py mock 回归",
  `模型选型：3 候选实测对比（${benchRes.candidates.map(c => c.model).join(" / ")}），结论 ${benchRes.recommendedExtractor}`,
  `独立审计逐项核查提交包合规/真实产出回溯/选型支撑/遗留修复/密钥卫生（${audit.findings.length} 项发现，${fixAck.fixed.length} 项已修复复验）`,
];
if (!allGreen) verified.pop();

const notCovered: string[] = [
  "官方 Docker 本地校验工具未跑（本机无 Docker）——以包内三项结构自检替代，最终以平台沙箱机测为准",
  "真实限流/重试路径未主动触发（未做压测，避免浪费额度）",
  "真值质量评估仅覆盖 User_Description_1 + P001..P005 黄金夹具，其余 5 个用户描述未逐个真值比对",
  "平台沙箱 Linux 环境实跑（manylinux 轮子兼容性）待首次提交的机测结果验证",
];
if (!allGreen) notCovered.push("存在未通过门禁，ZIP 未经完整验证，不建议直接提交");
for (const r of [fixRes, { module: "real", selfTest: realRes.openIssues.join(";"), openIssues: realRes.openIssues, files: [] }]) {
  if (r.openIssues.length > 0) notCovered.push(`${r.module} 未决事项：${r.openIssues.join("；")}`);
}

const mdLines: string[] = [
  "# 第二阶段报告：真实联调、选型与打包",
  "",
  `## 总体：${allGreen ? "具备首次提交条件" : "存在未过项，暂缓提交"}`,
  "",
  `- 真实端到端：${realOk ? "通过" : "未通过"}（${realRes.runs} 次运行，usage ${realRes.usageSummary}，末次 ${realRes.wallSeconds}s）`,
  `- 默认抽取模型：${benchRes.recommendedExtractor}（config 已${benchRes.configUpdated ? "更新" : "未更新"}）`,
  `- 提交包：${packRes.zipPath}（${packRes.zipMB}MB，${packRes.fileCount} 文件）`,
  `- 全量回归：${allGreen ? "通过" : "未全过"}`,
  `- 审计：${audit.findings.length} 项发现，${fixAck.fixed.length} 项已修复。总评：${audit.overall}`,
  "",
  "## 模型对比",
  "",
  ...benchRes.candidates.map(c => `- **${c.model}**：结构 ${c.structurePass}｜忠实度 ${c.faithfulness}｜${c.latencyUsage}｜${c.verdict}`),
  "",
  "## 真实联调修复记录",
  "",
  ...(realRes.issuesFixed.length > 0 ? realRes.issuesFixed.map(s => `- ${s}`) : ["（首轮即通过）"]),
  "",
  "## 审计发现",
  "",
];
if (findingsOut.length === 0) {
  mdLines.push("（无）");
} else {
  mdLines.push("| 位置 | 问题 | 级别 | 状态 |", "|---|---|---|---|");
  for (const f of findingsOut) {
    mdLines.push(`| ${f.where} | ${f.what} | ${f.severity} | ${f.status === "verified" ? "已修复复验" : "未修复/待确认"} |`);
  }
}
mdLines.push("", "## 未覆盖", "", ...notCovered.map(s => `- ${s}`), "", "## 下一步", "", "1. 经任务台上传 dist/agent.zip 完成首次提交（每天 ≤3 次）。", "2. 次日看机测分数与排名，登记提交记录。", "3. 按机测反馈迭代提示词与字段覆盖。");

try {
  await artifact.file("comparison", "reports/model_comparison.md", { title: "模型选型对比报告", description: "3 个候选模型在示例数据上的结构/忠实度/延迟/成本对比。" });
} catch {
  notCovered.push("reports/model_comparison.md 缺失，未发布选型卡片");
}
try {
  await artifact.file("real-sample", "reports/e2e_real_output/User_Description_1/recommendation.md", { title: "真实模型推荐报告样例", description: "qwen 系真实抽取生成的 recommendation.md，可看真实输出形态。" });
} catch {
  notCovered.push("reports/e2e_real_output/User_Description_1/recommendation.md 缺失，未发布真实样例");
}
await artifact.markdown("phase2-report", mdLines.join("\n"), {
  title: "第二阶段报告",
  description: "真实联调结果、模型选型、提交包自检与审计结论。",
  primary: true,
});

const result: WorkflowReport = {
  conclusion: allGreen
    ? `第二阶段完成：真实模型端到端通过（${realRes.runs} 次运行，总 usage ${realRes.usageSummary}，末次 ${realRes.wallSeconds}s）；默认抽取模型定为 ${benchRes.recommendedExtractor}；提交包 ${packRes.zipPath}（${packRes.zipMB}MB）通过包内自检与全量回归；审计 ${audit.findings.length} 项发现、${fixAck.fixed.length} 项已修复。审计总评：${audit.overall} dist/agent.zip 具备首次提交条件，待你确认后经任务台上传。`
    : `第二阶段未完全达标：${[!realOk ? "真实端到端未通过" : "", !pkgOk ? "包自检未通过" : "", !allGreen ? "全量回归未全过" : ""].filter(Boolean).join("；")}。请先查看 reports/progress.md 与《第二阶段报告》再决定下一步。`,
  findings: findingsOut,
  verified,
  notCovered,
};
return result;