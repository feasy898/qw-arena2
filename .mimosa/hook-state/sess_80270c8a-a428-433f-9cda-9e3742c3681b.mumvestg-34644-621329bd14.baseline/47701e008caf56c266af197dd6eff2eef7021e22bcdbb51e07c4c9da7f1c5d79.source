# 用无头 Edge + CDP 注入 Cookie，加载指定页面并抓取全部网络响应与渲染结果。
# 用法: python cdp_fetch.py <url> <输出目录> [等待秒数]
import asyncio
import base64
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

import websockets

EDGE = r"C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe"
COOKIE_FILE = os.path.join(os.path.dirname(__file__), "..", ".secrets", "edge_cookies.json")
DEBUG_PORT = 9333


def launch_edge() -> subprocess.Popen:
    profile = tempfile.mkdtemp(prefix="edge_cdp_")
    return subprocess.Popen([
        EDGE, "--headless", "--disable-gpu", "--no-first-run",
        f"--remote-debugging-port={DEBUG_PORT}", f"--user-data-dir={profile}",
        "--window-size=1440,900", "about:blank",
    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def wait_debugger(timeout=15.0):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{DEBUG_PORT}/json/version", timeout=2) as r:
                return json.load(r)
        except Exception:
            time.sleep(0.4)
    raise RuntimeError("CDP endpoint not reachable")


async def new_tab_ws() -> str:
    # 新版要求 PUT /json/new
    req = urllib.request.Request(f"http://127.0.0.1:{DEBUG_PORT}/json/new?about:blank", method="PUT")
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            info = json.load(r)
    except Exception:
        with urllib.request.urlopen(f"http://127.0.0.1:{DEBUG_PORT}/json/new", timeout=5) as r:
            info = json.load(r)
    return info["webSocketDebuggerUrl"]


class CDP:
    def __init__(self, ws):
        self.ws = ws
        self.mid = 0
        self.pending = {}
        self.events = []

    async def send(self, method, params=None):
        self.mid += 1
        mid = self.mid
        fut = asyncio.get_event_loop().create_future()
        self.pending[mid] = fut
        await self.ws.send(json.dumps({"id": mid, "method": method, "params": params or {}}))
        return await fut

    async def recv_loop(self):
        async for raw in self.ws:
            msg = json.loads(raw)
            if "id" in msg and msg["id"] in self.pending:
                fut = self.pending.pop(msg["id"])
                if msg.get("error"):
                    fut.set_exception(RuntimeError(str(msg["error"])))
                else:
                    fut.set_result(msg.get("result", {}))
            elif "method" in msg:
                self.events.append({"method": msg["method"], "params": msg["params"]})


async def main():
    url = sys.argv[1]
    outdir = os.path.abspath(sys.argv[2])
    wait_s = float(sys.argv[3]) if len(sys.argv) > 3 else 15.0
    os.makedirs(outdir, exist_ok=True)

    proc = launch_edge()
    try:
        wait_debugger()
        ws_url = await new_tab_ws()
        async with websockets.connect(ws_url, max_size=200 * 1024 * 1024) as ws:
            cdp = CDP(ws)
            recv = asyncio.create_task(cdp.recv_loop())

            await cdp.send("Network.enable")
            await cdp.send("Page.enable")
            await cdp.send("Runtime.enable")

            # 注入 qianwenai 域登录 Cookie
            with open(os.path.abspath(COOKIE_FILE), encoding="utf-8") as f:
                cookies = json.load(f)
            n_inj = 0
            for c in cookies:
                if not c.get("value") or "qianwenai" not in c.get("domain", ""):
                    continue
                try:
                    c["value"].encode("latin-1")
                except UnicodeEncodeError:
                    continue
                try:
                    await cdp.send("Network.setCookie", {
                        "name": c["name"], "value": c["value"],
                        "domain": c["domain"], "path": c.get("path", "/"),
                        "secure": bool(c.get("secure")), "httpOnly": bool(c.get("httpOnly")),
                    })
                    n_inj += 1
                except Exception as e:
                    print(f"  setCookie failed {c['name']}: {e}")
            print(f"cookies injected: {n_inj}")

            t0 = time.time()
            await cdp.send("Page.navigate", {"url": url})
            await asyncio.sleep(wait_s)
            res = await cdp.send("Runtime.evaluate", {"expression": "location.href", "returnByValue": True})
            print("now at:", res.get("result", {}).get("value"))

            # 收集响应索引
            bodies = {}
            for ev in cdp.events:
                if ev.get("method", "") != "Network.responseReceived":
                    continue
                r = ev["params"]["response"]
                rid = ev["params"]["requestId"]
                bodies[rid] = {
                    "url": r["url"], "status": r["status"],
                    "type": ev.get("type", ""), "mime": r.get("mimeType", ""),
                }
            interesting = {
                rid: meta for rid, meta in bodies.items()
                if meta["type"] in ("XHR", "Fetch") or "api" in meta["url"].lower()
            }
            print(f"total responses: {len(bodies)}, interesting: {len(interesting)}")
            manifest = []
            for rid, meta in interesting.items():
                try:
                    res = await cdp.send("Network.getResponseBody", {"requestId": rid})
                    body = res.get("body", "")
                    if res.get("base64Encoded"):
                        body = base64.b64decode(body).decode("utf-8", "replace")
                except Exception as e:
                    body = f"<<getResponseBody failed: {e}>>"
                safe = rid.replace("-", "")
                fn = f"resp_{safe}.txt"
                with open(os.path.join(outdir, fn), "w", encoding="utf-8") as f:
                    f.write(f"URL: {meta['url']}\nSTATUS: {meta['status']} TYPE: {meta['type']}\n\n{body}")
                manifest.append({**meta, "file": fn})
            with open(os.path.join(outdir, "manifest.json"), "w", encoding="utf-8") as f:
                json.dump(manifest, f, ensure_ascii=False, indent=1)

            # 渲染后的 DOM
            res = await cdp.send("Runtime.evaluate", {
                "expression": "document.documentElement.outerHTML",
                "returnByValue": True,
            })
            with open(os.path.join(outdir, "rendered_dom.html"), "w", encoding="utf-8") as f:
                f.write(res["result"]["value"])
            print("rendered dom saved")

            # 全量响应清单（含静态资源）
            with open(os.path.join(outdir, "all_responses.json"), "w", encoding="utf-8") as f:
                json.dump(list(bodies.values()), f, ensure_ascii=False, indent=1)

            recv.cancel()
            print(f"elapsed {time.time()-t0:.1f}s, done -> {outdir}")
    finally:
        proc.kill()


if __name__ == "__main__":
    asyncio.run(main())
