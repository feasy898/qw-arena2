#!/usr/bin/env python3
"""tools/trigger_cnb_real.py — 触发 CNB 官方沙箱真实模型运行（诊断用）。

通过 OPENAPI build/start 的 config 字段内联下发流水线 YAML：
- 官方镜像（Debian12 + 全套运行时）内直连 maas 网关跑完整真实模型链路；
- DASHSCOPE_API_KEY 从 .secrets/dashscope_api_key.txt 读取，经 HTTPS 注入
  本次构建的 env，不写入任何仓库文件；构建日志不打印其值。

用法: python tools/trigger_cnb_real.py
"""
import json
import os
import sys
import urllib.request

REPO = "Cloudbird-Software/qw-arena-agent"
API = "https://api.cnb.cool"

SECRETS = os.path.join(os.path.dirname(__file__), "..", ".secrets")


def _read(name: str) -> str:
    with open(os.path.join(SECRETS, name), encoding="utf-8") as fh:
        return fh.read().strip()


def main() -> int:
    token = _read("cnb_token.txt").split(":", 1)[1]
    key = _read("dashscope_api_key.txt")
    base_url = (_read("base_url.txt") if os.path.exists(
        os.path.join(SECRETS, "base_url.txt")) else
        "https://maas.qianwenaiapi.com/compatible-mode/v1").strip()

    config = f"""main:
  api_trigger:
    - name: official-sandbox-real-run
      services:
        - docker
      docker:
        image: python:3.12-slim-bookworm
      env:
        DASHSCOPE_API_KEY: "{key}"
        QW_FORCE_MOCK: "0"
        OPENAI_BASE_URL: "{base_url}"
      stages:
        - name: build-package
          script: |
            pip install --no-cache-dir -q requests
            python tools/package.py
        - name: check-env
          script: |
            test -n "$DASHSCOPE_API_KEY" && echo "Key 注入 OK（长度 ${{#DASHSCOPE_API_KEY}}）"
            test "$QW_FORCE_MOCK" = "0" && echo "QW_FORCE_MOCK=0 OK"
        - name: setup-tool
          script: |
            rm -rf /tmp/official && mkdir -p /tmp/official && cd /tmp/official
            cp "${{CNB_BUILD_WORKSPACE}}/tools/official_validation/Dockerfile" .
            cp "${{CNB_BUILD_WORKSPACE}}/tools/official_validation/docker-compose.yml" .
            cp -r "${{CNB_BUILD_WORKSPACE}}/dist/agent" ./agent
            mkdir -p input/00_User_Descriptions input/01_Ecommerce_Listings input/02_Media_Coverage_and_Reviews input/03_User_Feedback_and_Complaints input/04_Brand_Official_Sites
            WS="${{CNB_BUILD_WORKSPACE}}/raw/dataset_sample/Data_for_Users"
            cp "$WS/00_User_Descriptions/User_Description_1.txt" input/00_User_Descriptions/
            cp "$WS/01_Ecommerce_Listings/Ecommerce_Listing_Snapshot.csv" input/01_Ecommerce_Listings/
            cp "$WS/02_Media_Coverage_and_Reviews/"* input/02_Media_Coverage_and_Reviews/
            cp "$WS/03_User_Feedback_and_Complaints/"* input/03_User_Feedback_and_Complaints/
            cp "$WS/04_Brand_Official_Sites/"* input/04_Brand_Official_Sites/
        - name: build-image
          script: cd /tmp/official && docker compose build agent 2>&1 | tail -3
        - name: real-full-run
          script: |
            docker network create official_internet 2>/dev/null || true
            cd /tmp/official && docker run --rm --network official_internet \\
              -e DASHSCOPE_API_KEY="$DASHSCOPE_API_KEY" \\
              -e QW_FORCE_MOCK=0 \\
              -e OPENAI_BASE_URL="$OPENAI_BASE_URL" \\
              -e AGENT_LOG_DIR=/home/user/ws/logs \\
              official-agent sh -c "python /workspace/agent.py --prompt '请根据 /home/user/ws/input 中的数据完成消费决策任务，将结果输出到 /home/user/ws/output'; echo AGENT_EXIT=\\$?; echo '--- 输出产物 ---'; ls -la /home/user/ws/output/ 2>/dev/null; for f in /home/user/ws/output/*.md; do echo \\"== \\$f ==\\"; head -25 \\"\\$f\\"; done 2>/dev/null; echo '--- agent.log ---'; tail -80 /home/user/ws/logs/agent.log 2>/dev/null"
"""

    body = json.dumps({
        "event": "api_trigger",
        "title": "official sandbox real-model run (inline config)",
        "config": config,
    }).encode("utf-8")

    req = urllib.request.Request(
        f"{API}/{REPO}/-/build/start", data=body, method="POST",
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            print(resp.read().decode("utf-8")[:400])
            return 0
    except urllib.error.HTTPError as exc:
        print(f"HTTP {exc.code}: {exc.read().decode('utf-8', 'replace')[:400]}")
        return 1


if __name__ == "__main__":
    sys.exit(main())
