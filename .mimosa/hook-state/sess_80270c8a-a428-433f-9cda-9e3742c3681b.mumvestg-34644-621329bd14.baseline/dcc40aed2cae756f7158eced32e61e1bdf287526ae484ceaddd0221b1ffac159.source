interface ContractsResult {
  /** 写出的契约与骨架文件（workspace 相对路径） */
  files: string[];
  /** 需要用户或平台才能确认的事项 */
  blockers: string[];
  /** 关键设计决定，每条一句话 */
  decisions: string[];
}

interface DevResult {
  /** 模块名（用任务里指定的名称） */
  module: string;
  /** 写出/修改的文件 */
  files: string[];
  /** 自测结论一句话：跑了什么、结果如何 */
  selfTest: string;
  /** 未解决问题 */
  openIssues: string[];
}

interface AuditFinding {
  /** 问题位置：文件路径，可带 :行号 */
  where: string;
  /** 一句话说清问题本身 */
  what: string;
  /** 证据：读到的代码或输出片段 */
  evidence: string;
  /** low=规范瑕疵；medium=会影响得分；high=会导致失败或错误结果 */
  severity: "low" | "medium" | "high";
  /** 一句话修复建议 */
  suggestion: string;
}

interface AuditResult {
  findings: AuditFinding[];
  /** 整体评估一句话 */
  overall: string;
}

interface FixResult {
  /** 已修复问题对应的位置（AuditFinding.where 或失败输出中涉及的文件） */
  fixed: string[];
  /** 明确不修的问题及原因 */
  notFixed: string[];
}

interface Finding {
  /** Workspace-relative path, with a line when it applies: "src/a.ts:42". */
  where: string;
  /** One sentence: what is wrong, or what was found. */
  what: string;
  /** What showed it: the lines read, or the command and the output that proved it. */
  evidence: string;
  /** "verified" when an independent subagent or a deterministic check confirmed it; "unconfirmed" when confirmation failed or was not attempted. */
  status: "verified" | "unconfirmed";
  /** How much it matters. Reserve "high" for data loss, a crash, or a wrong result. */
  severity: "low" | "medium" | "high";
}

interface WorkflowReport {
  /** Two or three sentences answering what the user asked for. */
  conclusion: string;
  findings: Finding[];
  /** What the run checked and how: the commands it ran, the files it covered. */
  verified: string[];
  /** What the run did not look at or could not check, and why. */
  notCovered: string[];
}

const COMMON = [
  "项目：千问AI Arena「消费决策好帮手：智能选购顾问」参赛 Agent 开发，工作区即当前目录（D:\\workspace\\qw-arena2）。",
  "开工前必读：SPEC.md（唯一权威规格）、AGENTS.md（开发纪律）、contracts/（契约，若已存在）。",
  "官方赛题原文：raw/competition-problemData.txt；官方示例数据集：raw/dataset_sample/Data_for_Users/（6 用户描述 × 5 款耳机产品，编号两位/三位混用）；全量比赛背景：比赛完整资料.md。",
  "环境：Windows + Python 3.12，只允许标准库 + requests；测试用 pytest。",
  "纪律：只创建/修改分配给你的文件；完成后运行自己模块的测试并确保通过；不伪造任何结果；遇到指令矛盾或环境缺失等无法自行解决的关键阻塞，用升级机制提问而不是绕过。",
].join("\n");

const CONTRACTS_PROMPT = `${COMMON}

你是契约与集成负责人。任务：为全部并行开发打好数据契约和可编译的模块骨架，这是所有人的地基，必须精确。

第一步通读：SPEC.md 全文、raw/competition-problemData.txt（重点：输出要求、字段组定义、机测 Prompt、评分维度 U1-U4/P1-P6/R1-R4）、raw/dataset_sample/Data_for_Users/ 下每个文件的实际内容与格式。

第二步产出：
1. contracts/field_catalog.json —— 画像 7 字段组（标识/基本情况/购买目标/预算/设备/场景/偏好）与产品 5 字段组（基础标识/产品力/品牌力/市场验证/购买与使用成本）的完整子字段目录；每个子字段含 name/type(文本|数字|区间|枚举|列表)/单位/缺失表达(统一「待核验」或「未提供」)/是否必须。粒度以能对上官方机测 Prompt 与评分维度为准（如画像「场景」须承载名称+时长+频率+优先级；「产品力」须覆盖降噪/声音与播放/续航/佩戴防护及适用条件）。
2. contracts/platform_contract.json —— 环境变量、模型白名单（仅 SPEC §2 列的文本模型）、时限 1800s/内存 4GB、三份产出文件名、退出码约定、--version 行为、--prompt 解析规则。
3. contracts/rules.json —— 编号归一（P01≡P001 尾号对齐）、证据纪律三档（可溯源/归纳依据/待核验）、冲突三步法、市场反馈表达层级、约束四态语义。
4. contracts/interfaces.md —— 模块签名：run(input_dir, output_dir, config)、ModelGateway.chat(messages, model, *, mock_key=None)->dict、extract_profile/extract_products、render_profile/render_products/render_recommendation、parse_profile/parse_products、validate_outputs(output_dir, input_dir)、constraint_matrix/select_recommendation、evaluate(input_dir, output_dir)。并固定 mock 网关夹具格式：mock 模式下按 mock_key 从 tests/fixtures/gateway/responses.json 取 {role:"assistant", content:"<JSON字符串>"} 响应；mock_key 缺失必须抛错（不许静默兜底）。
5. config.example.json —— 默认模型 qwen3.6-plus、并发 2、单请求重试上限 2、修复循环上限 2、软截止 1680s。
6. src/schemas.py —— SPEC §4 数据契约的 dataclass 完整定义。
7. src/ 全部模块骨架（input_adapter/source_index/product_registry/model_gateway/budget_manager/profile_extractor/product_extractor/reconciler/renderer/validators/constraint_engine/selector/report_writer/pipeline）：签名+docstring+TODO 主体，与 interfaces.md 严格一致。

第三步自检：python -m compileall -q src 必须通过；field_catalog 逐文件核对示例数据，确认能承载全部信息类型。

返回 ContractsResult：files=写出的文件；blockers=无法从现有资料确认的事项（如官方子字段精确模板）；decisions=你的关键取舍。`;

const INPUT_PROMPT = `${COMMON}

你负责输入层（可修改骨架中分配给你的文件）：src/input_adapter.py、src/source_index.py、src/product_registry.py、tests/unit/test_input_adapter.py、tests/unit/test_product_registry.py。

要求（细则见 SPEC §5）：
- load_input(input_dir)：解析 5 类信息源为 SourceRecord（source_id 稳定、source_type 分五类、original_text 保留原文、spans=文件+行号区间稳定编号）；CSV 用标准库 csv 正确处理编码与表头。
- 产品注册表：从文件名与 CSV 提取产品编号，P01≡P001 归一为 canonical_id 并保留别名；从官网文件名提取型号；同编号不同型号记身份冲突（不合并）；不修改品牌/型号文本。
- 测试直接以 raw/dataset_sample/Data_for_Users 为夹具：断言恰好 5 款产品 P001..P005、6 份用户描述、各信息源数量正确、编号归一正确、坏输入（缺目录/空文件）报错清晰。
- 纯确定性代码，不调模型。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「输入适配」）。`;

const GATEWAY_PROMPT = `${COMMON}

你负责模型网关（可修改骨架中分配给你的文件）：src/model_gateway.py、src/budget_manager.py、tests/unit/test_model_gateway.py、tests/unit/test_budget_manager.py。

要求（细则见 SPEC §11 与 contracts/interfaces.md）：
- 两种模式：real（环境变量 DASHSCOPE_API_KEY 存在且非 mock）/ mock（QW_FORCE_MOCK=1 强制，或无 Key 时自动）；mock 严格按 contracts 里固定的 responses.json 按 mock_key 取，缺失抛错。
- real：仅用 requests 调 {OPENAI_BASE_URL}/chat/completions（Bearer DASHSCOPE_API_KEY，model 必须在白名单，从 contracts/platform_contract.json 读）；解析 content 中的 JSON（容错提取 + 一次「请修复 JSON」重试）；429/5xx 指数退避+抖动重试≤2；鉴权失败/模型不存在抛 GatewayFatal 不重试；上下文超长抛 ContextTooLong 交调用方分块。
- budget_manager：截止时间（软截止 1680s）、并发信号量（默认 2）、token 预估（中文近似 len/2）与总量控制；超预算抛异常由上层降级。
- 网络注入可 fake：测试不真发请求（monkeypatch session），覆盖 mock 取数、重试、致命错误分类、预算到期。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「模型网关」）。`;

const EXTRACT_PROMPT = `${COMMON}

你负责抽取流水线（可修改骨架中分配给你的文件）：prompts/profile_extraction.md、prompts/product_extraction.md、src/profile_extractor.py、src/product_extractor.py、src/reconciler.py、tests/unit/test_profile_extractor.py、tests/unit/test_product_extractor.py、tests/unit/test_reconciler.py、tests/fixtures/gateway/responses.json（新建或补充）。

要求（细则见 SPEC §6/§7/§8）：
- 两份提示词：画像抽取（原子化拆解、硬约束/软偏好区分、场景含名称+时长+频率+优先级、偏好只收原文明确表达、输出严格 JSON）；产品抽取（五字段组全覆盖、每个取值带 evidence_refs 指向 source_id+span、宣传话术不得当事实、无统一口径标「待核验」）。提示词里写明输出 JSON 的精确结构（与 src/schemas.py 对齐）。
- 代码：调网关（传 mock_key）→ 校验 → 失败一次修复重试；profile_extractor 产出 UserNeed 列表+画像字段；product_extractor 按产品逐款抽取 FactCell；reconciler 归并五源（冲突三步法、FactCell.status 区分、市场反馈按表达层级）。
- 夹具：先逐字读 raw/dataset_sample/Data_for_Users/ 的真实文件，为 mock_key「profile:user_1」与「products:P001」..「products:P005」写出忠实于原文的响应夹具（这些同时是后续真值评估的黄金夹具，数据必须真实取自示例数据，不许编造）。
- 测试离线跑（mock 网关），断言抽取结构合法、evidence_refs 可回溯到真实 span、编号归一后的产品全覆盖。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「抽取流水线」）。`;

const RENDER_PROMPT = `${COMMON}

你负责渲染与校验（可修改骨架中分配给你的文件）：src/renderer.py、src/validators.py、tests/unit/test_renderer.py、tests/unit/test_validators.py。

要求（细则见 SPEC §10 与官方机测 Prompt 的输出格式）：
- 渲染：结构化对象→Markdown 全部程序模板生成。render_profile（字段组/字段名/取值 三列表格，覆盖 7 字段组）、render_products（每款一节「## P001 型号名」，节内五行组表格，所有产品表结构完全一致，字段顺序取 field_catalog）、render_recommendation（推荐结果表恰好 3 行：推荐层级/产品ID/产品/画像匹配与推荐理由/注意事项 + 表后一句综合结论；未选原因表：产品ID/未进入前三的主要原因/建议改变条件）。缺失值统一「待核验」或「未提供」。
- parse：parse_profile/parse_products 把渲染后的 md 忠实解析回对象（供决策阶段回读，实现「冻结→回读」铁律）。
- validators：SPEC §10 的 10 项确定性检查全部实现（文件数与命名/产品全集一致/品牌型号原样/表结构一致/推荐三款且∈有效集/未选表全覆盖/风险核验字段非空/引用不越界/退出与编码/表格列数一致无坏行）。
- 测试：手造小型对象渲染后自 parse 回环相等；构造坏输出（缺文件、表结构不一致、漏产品、推荐数错）断言校验器逐项报错。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「渲染与校验」）。`;

const DECISION_PROMPT = `${COMMON}

你负责决策引擎（可修改骨架中分配给你的文件）：src/constraint_engine.py、src/selector.py、src/report_writer.py、tests/unit/test_constraint_engine.py、tests/unit/test_selector.py、tests/unit/test_report_writer.py。

要求（细则见 SPEC §9，逐条落实）：
- constraint_engine：UserNeed×产品FactCell→四态矩阵（PASS/FAIL/UNKNOWN/NOT_APPLICABLE），每个结果带 profile_reference/attribute_reference/explanation；UNKNOWN≠PASS；预算边界、设备生态兼容性等判定须引用具体字段。
- selector：有效集 E=全部适用硬约束 PASS；三款全从 E 选；排序依据（硬约束→高优先级需求匹配→可比取舍→证据缺口）可解释、可还原为属性×需求，禁止无口径效用分；不足 3 款时按 SPEC 异常路径处理（保留有效首选+明示「尚不构成有效备选」，不放宽约束不虚构）。
- report_writer：从 DecisionPlan 组装推荐卡全部固定字段（身份/适配结论/事实依据（引用格式如 产品属性｜P001｜价格）/取舍/代价与风险（不编造缺点）/购买前核验（聚焦真实不确定性）/改选条件）与未选原因表（五类原因+条件句对应+多否决条件不拆分）+一句综合结论。
- 输入只允许是 parse_profile/parse_products 回读的对象——不许 import 原始资料。
- 测试：构造 3/2/1/0 款有效四组用例断言行为；断言推荐理由含具体字段引用；断言未选表覆盖全集。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「决策引擎」）。`;

const EVAL_PROMPT = `${COMMON}

你负责本地评估工具（可修改骨架中分配给你的文件）：tools/evaluate.py、tests/regression/test_evaluate.py、夹具目录 tests/fixtures/eval/valid/ 与 tests/fixtures/eval/invalid/。

要求（细则见 SPEC §12 第一类）：
- evaluate(input_dir, output_dir)：调用 validators 全部检查 + 输入侧交叉核对（从 input_dir 独立重建产品全集，与 product_list.md 节集合、recommendation.md 的 3+其余 全集做差集比对）；输出 JSON 报告（每项检查 pass/fail+说明）到 stdout；任何结构检查失败→退出码 1，全过→0。不依赖模型、不依赖网关。
- 夹具：valid/ 是一份手工构造的小型合法输出（1-2 款产品即可，配合一个 mini input 目录）；invalid/ 至少覆盖三种坏法（漏产品/表结构不一致/推荐数错）。
- 测试断言：valid 退出 0；每种 invalid 都被正确点名。

完成后运行你自己的 pytest 用例。返回 DevResult（module 填「评估工具」）。`;

const INTEGRATION_PROMPT = `${COMMON}

你是集成工程师，负责把全部模块接成可提交形态（可修改：src/pipeline.py、agent/ 下全部文件、tools/e2e_mock.py、reports/progress.md、reports/blockers.md；如发现模块间接口不匹配，可小幅调整 src/ 内任意模块使其协同，但 contracts/ 与 SPEC.md 不许改，改动记录进 progress.md）。

要求：
- src/pipeline.py：按 SPEC §3 主链编排——load_input→画像抽取+产品抽取+归并→覆盖检查→渲染冻结 profile/products 两份 md→parse 回读→约束判定→选择→推荐渲染→validators 校验→有限修复（≤2 轮）→恰好写 3 份 md；全程遵守隔离铁律；网关从 config 与环境变量初始化；软截止前降级（降级顺序见 SPEC §11，禁止丢产品）。
- agent/agent.py：argparse 支持 --version（打印与 agent.json 一致的 0.1.0，退出码 0）与 --prompt（从自然语言指令中正则解析输入/输出目录；找不到时退出码非 0 并写日志）；sys.path 处理使包内可用 src；日志写 AGENT_LOG_DIR（默认 reports/logs/）下 agent.log；不硬编码任何 Key。
- agent/agent.json：{"runtime":"python","version":"0.1.0"}；agent/requirements.txt：requests。
- tools/e2e_mock.py：设 QW_FORCE_MOCK=1，对 raw/dataset_sample/Data_for_Users 跑 agent（直接调 run() 或子进程均可），输出到 reports/e2e_sample_output/，然后调 tools/evaluate.py 校验；打印摘要；按结果退出 0/1。
- 亲手跑一遍 python tools/e2e_mock.py 与 python agent/agent.py --version，修到通过为止；把运行摘要写进 reports/progress.md。全量 pytest 由工作流统一执行，不必抢跑。

返回 DevResult（module 填「集成与入口」，selfTest 写你实测的两个命令结果）。`;

const AUDIT_PROMPT = `${COMMON}

你是独立审计员，用新鲜视角审查第一阶段交付。**不许编辑任何文件**，只读代码、夹具与输出。

审查对象：src/ 全部、agent/、tools/evaluate.py、tools/e2e_mock.py、prompts/、tests/fixtures/gateway/responses.json、reports/e2e_sample_output/ 下三份 md。对照基准：SPEC.md + raw/competition-problemData.txt 官方原文。

逐项核查：
(a) 三份输出文档结构与官方机测 Prompt 的输出要求逐项对齐（表格列名、字段组、行数要求、命名）；
(b) 隔离铁律：决策模块输入确实来自 parse 回读对象，链路上无原始资料旁路；
(c) validators 是否覆盖 SPEC §10 全部 10 项，有没有假实现（检查器存在但逻辑空转）；
(d) 模型白名单与环境变量读取方式与 contracts/platform_contract.json 一致，无硬编码 Key；
(e) agent.py --version/agent.json/requirements.txt 三者一致，--prompt 解析对官方示例句式有效；
(f) 两份抽取提示词是否完整体现证据纪律（待核验/归纳依据/宣传话术不当事实）；
(g) 抽查 fixtures 忠实性：随机抽 2 个产品夹具与 1 个画像夹具，对照 raw 数据源文件核对取值是否真实可回溯。

只报真问题，每条给 where/what/evidence/severity/suggestion；severity 按SPEC标注口径。没有问题就返回空 findings——不要为了显得尽责而凑数。同时给 overall 一句总评。`;

artifact.board("modules", {
  title: "第一阶段模块进度",
  key: "module",
  status: "status",
  columns: ["开发中", "已完成", "有问题"],
  cardTitle: "module",
  detail: [{ field: "selfTest", label: "自测" }],
});

const moduleNotes: { module: string; selfTest: string; openIssues: string[] }[] = [];

phase("制定数据契约与模块骨架");
const contractsOwner = agent("契约管理员", {
  system: "你是契约与集成负责人，为并行开发打地基；产出必须可编译、可与官方原文核对；无法确认的事项如实登记为 blocker，绝不编造。",
});
const contracts = await contractsOwner.ask<ContractsResult>(CONTRACTS_PROMPT);
let compile = await world.run("python", ["-m", "compileall", "-q", "src"], { timeoutMs: 120000 });
if (compile.exitCode !== 0) {
  log("骨架编译未过，契约管理员修复中");
  await contractsOwner.ask(`python -m compileall -q src 失败，请修复骨架：\n${compile.stderr.slice(-3000)}`);
  compile = await world.run("python", ["-m", "compileall", "-q", "src"], { timeoutMs: 120000 });
}
const compileOk = compile.exitCode === 0;
report({ module: "契约与骨架", status: compileOk ? "已完成" : "有问题", selfTest: compileOk ? "compileall 通过" : "compileall 失败" }, "modules");
moduleNotes.push({ module: "契约与骨架", selfTest: `blockers ${contracts.blockers.length} 条`, openIssues: contracts.blockers });
log(`契约就绪：${contracts.files.length} 个文件，${contracts.blockers.length} 条待确认事项`);

phase("并行开发输入适配与模型网关");
report({ module: "输入适配", status: "开发中", selfTest: "-" }, "modules");
report({ module: "模型网关", status: "开发中", selfTest: "-" }, "modules");
const [inputRes, gwRes] = await Promise.all([
  agent("输入适配工程师", { system: "你是严谨的解析层工程师：确定性、可测试、对脏输入报错清晰。" }).ask<DevResult>(INPUT_PROMPT),
  agent("网关工程师", { system: "你是可靠的集成工程师：错误分类清楚、重试有界、绝不静默吞错。" }).ask<DevResult>(GATEWAY_PROMPT),
]);
for (const r of [inputRes, gwRes]) {
  moduleNotes.push({ module: r.module, selfTest: r.selfTest, openIssues: r.openIssues });
  report({ module: r.module, status: "已完成", selfTest: r.selfTest }, "modules");
}

phase("并行开发抽取流水线与渲染校验");
report({ module: "抽取流水线", status: "开发中", selfTest: "-" }, "modules");
report({ module: "渲染与校验", status: "开发中", selfTest: "-" }, "modules");
const [extractRes, renderRes] = await Promise.all([
  agent("抽取工程师", { system: "你是信息抽取专家：忠实原文、原子化、每个取值可溯源；夹具数据必须取自真实示例文件。" }).ask<DevResult>(EXTRACT_PROMPT),
  agent("渲染校验工程师", { system: "你是格式与校验工程师：确定性渲染、parse 回环一致、校验器逐项真实现。" }).ask<DevResult>(RENDER_PROMPT),
]);
for (const r of [extractRes, renderRes]) {
  moduleNotes.push({ module: r.module, selfTest: r.selfTest, openIssues: r.openIssues });
  report({ module: r.module, status: "已完成", selfTest: r.selfTest }, "modules");
}

phase("并行开发决策引擎与评估工具");
report({ module: "决策引擎", status: "开发中", selfTest: "-" }, "modules");
report({ module: "评估工具", status: "开发中", selfTest: "-" }, "modules");
const [decisionRes, evalRes] = await Promise.all([
  agent("决策引擎工程师", { system: "你是决策逻辑工程师：约束判定严谨、UNKNOWN 不放水、取舍可解释。" }).ask<DevResult>(DECISION_PROMPT),
  agent("评估工程师", { system: "你是质量工具工程师：评估器独立重建事实、坏输出必须被点名。" }).ask<DevResult>(EVAL_PROMPT),
]);
for (const r of [decisionRes, evalRes]) {
  moduleNotes.push({ module: r.module, selfTest: r.selfTest, openIssues: r.openIssues });
  report({ module: r.module, status: "已完成", selfTest: r.selfTest }, "modules");
}

phase("集成端到端流水线");
report({ module: "集成与入口", status: "开发中", selfTest: "-" }, "modules");
const integrator = agent("集成工程师", {
  system: "你是集成负责人：把所有模块接成可提交形态；接口不匹配由你协调；不许删测试、不许改 contracts 与 SPEC；跑不通就修到通，修不动就升级提问。",
});
const integRes = await integrator.ask<DevResult>(INTEGRATION_PROMPT);
moduleNotes.push({ module: integRes.module, selfTest: integRes.selfTest, openIssues: integRes.openIssues });
report({ module: integRes.module, status: "已完成", selfTest: integRes.selfTest }, "modules");

phase("全量测试与端到端验证，失败即修复");
report({ module: "端到端验证", status: "开发中", selfTest: "-" }, "modules");
let gatesPassed = false;
let gateFeedback = "";
for (let round = 1; round <= 3; round++) {
  const unit = await world.run("python", ["-m", "pytest", "tests", "-q", "--tb=short"], { timeoutMs: 600000 });
  if (unit.exitCode !== 0) {
    gateFeedback = `python -m pytest tests -q 退出码 ${unit.exitCode}：\n${(unit.stdout + "\n" + unit.stderr).slice(-6000)}`;
  } else {
    const ver = await world.run("python", ["agent/agent.py", "--version"], { timeoutMs: 120000 });
    if (ver.exitCode !== 0) {
      gateFeedback = `agent/agent.py --version 失败：\n${(ver.stdout + "\n" + ver.stderr).slice(-3000)}`;
    } else {
      const e2e = await world.run("python", ["tools/e2e_mock.py"], { timeoutMs: 900000 });
      if (e2e.exitCode === 0) {
        gatesPassed = true;
        break;
      }
      gateFeedback = `tools/e2e_mock.py 退出码 ${e2e.exitCode}：\n${(e2e.stdout + "\n" + e2e.stderr).slice(-6000)}`;
    }
  }
  log(`第 ${round} 轮门禁未过，集成工程师修复中`);
  report({ module: "端到端验证", status: "有问题", selfTest: `第 ${round} 轮失败` }, "modules");
  await integrator.ask<FixResult>(`门禁未通过，请修复。不许删测试、不许改真值、不许绕过校验。失败输出节选：\n${gateFeedback}\n修完把改动文件放进返回值 fixed。`);
}
if (gatesPassed) {
  report({ module: "端到端验证", status: "已完成", selfTest: "pytest+版本+e2e 全过" }, "modules");
  log("全部门禁通过：compileall、pytest、--version、e2e_mock");
} else {
  log("三轮修复后门禁仍未全过，问题已记录，交独立审计复核");
}

phase("独立审计并修复发现的问题");
report({ module: "独立审计", status: "开发中", selfTest: "-" }, "modules");
const auditor = agent("独立审计员", {
  system: "你是没参与过开发的独立审计员：只读不改，逐条对照官方原文与 SPEC 找真问题；凑数式发现比没有发现更糟；如果某个检查环境里做不了，如实说做不了。",
});
const audit = await auditor.ask<AuditResult>(AUDIT_PROMPT);
report({ module: "独立审计", status: "已完成", selfTest: `${audit.findings.length} 项发现` }, "modules");
log(`审计完成：${audit.findings.length} 项发现（high ${audit.findings.filter(f => f.severity === "high").length} / medium ${audit.findings.filter(f => f.severity === "medium").length} / low ${audit.findings.filter(f => f.severity === "low").length}）`);
const fixables = audit.findings.filter(f => f.severity === "high" || f.severity === "medium");
let fixResult: FixResult = { fixed: [], notFixed: [] };
if (fixables.length > 0) {
  fixResult = await integrator.ask<FixResult>(`修复以下审计发现（不许删测试、不许改 SPEC/contracts；确属误报的可放进 notFixed 并写明理由）：\n${JSON.stringify(fixables, null, 1)}`);
  const reunit = await world.run("python", ["-m", "pytest", "tests", "-q"], { timeoutMs: 600000 });
  const ree2e = await world.run("python", ["tools/e2e_mock.py"], { timeoutMs: 900000 });
  if (reunit.exitCode !== 0 || ree2e.exitCode !== 0) {
    await integrator.ask(`修复后复验仍失败（pytest=${reunit.exitCode}，e2e=${ree2e.exitCode}）：\n${(reunit.stdout + "\n" + reunit.stderr + "\n" + ree2e.stdout + "\n" + ree2e.stderr).slice(-5000)}\n请做最后一次修复，只修导致失败的问题。`);
    const fin1 = await world.run("python", ["-m", "pytest", "tests", "-q"], { timeoutMs: 600000 });
    const fin2 = await world.run("python", ["tools/e2e_mock.py"], { timeoutMs: 900000 });
    gatesPassed = fin1.exitCode === 0 && fin2.exitCode === 0;
  }
}

const findingsOut: Finding[] = audit.findings.map(f => ({
  where: f.where,
  what: f.what,
  evidence: f.evidence,
  severity: f.severity,
  status: fixResult.fixed.includes(f.where) ? "verified" : "unconfirmed",
}));

const verified: string[] = [];
if (compileOk) verified.push("python -m compileall -q src（契约阶段与修复后均通过）");
if (gatesPassed) verified.push("python -m pytest tests -q 全量 + agent/agent.py --version + tools/e2e_mock.py 端到端（mock 网关）全部退出码 0");
verified.push(`独立审计覆盖 src/、agent/、tools/、prompts/、夹具与 e2e 输出（${audit.findings.length} 项发现，其中 ${fixResult.fixed.length} 项已修复并复验）`);

const notCovered: string[] = [
  "真实模型调用与限流实测：等待用户提供 DASHSCOPE_API_KEY（第二阶段）",
  "真实平台沙箱运行、ZIP 打包（agent/ 目录组装、依赖 vendor）与榜单提交：第二阶段",
  "关键事实精确率/召回率真值评估：需真实模型抽取结果后才能测",
  "30 分钟时限与 4GB 内存下的压力行为：mock 模式不代表真实时延",
];
if (!gatesPassed) notCovered.push("部分门禁三轮修复后仍未通过，详见报告结论，需人工介入");
if (contracts.blockers.length > 0) notCovered.push(`契约阶段登记的待确认事项：${contracts.blockers.join("；")}`);

const mdLines: string[] = [
  "# 第一阶段基线开发报告",
  "",
  `## 总体：${gatesPassed ? "端到端基线已跑通" : "基线未完全跑通"}`,
  "",
  `- 骨架编译：${compileOk ? "通过" : "失败"}`,
  `- 全量测试 + 版本自检 + mock 端到端：${gatesPassed ? "全部通过" : "未全部通过"}`,
  `- 审计发现：${audit.findings.length} 项（已修复 ${fixResult.fixed.length} 项）`,
  `- 审计总评：${audit.overall}`,
  "",
  "## 模块清单",
  "",
  ...moduleNotes.map(m => `- **${m.module}**：${m.selfTest}${m.openIssues.length > 0 ? `（未决：${m.openIssues.join("；")}）` : ""}`),
  "",
  "## 审计发现",
  "",
];
if (findingsOut.length === 0) {
  mdLines.push("（无）");
} else {
  mdLines.push("| 位置 | 问题 | 级别 | 状态 |", "|---|---|---|---|");
  for (const f of findingsOut) {
    mdLines.push(`| ${f.where} | ${f.what} | ${f.severity} | ${f.status === "verified" ? "已修复复验" : "未修复/待确认"} |`);
  }
}
mdLines.push("", "## 未覆盖（为何）", "", ...notCovered.map(s => `- ${s}`), "", "## 下一步", "", "1. 用户提供 DASHSCOPE_API_KEY → 真实网关联调、模型选型对比（qwen3.6-plus / qwen3.7-max / deepseek-v4 系）。", "2. 打包 agent/ ZIP（依赖 vendor）→ 本地 Docker 验证工具复跑。", "3. 首次平台提交（每天 ≤3 次，榜单 T+1）。");

try {
  await artifact.file("sample-output", "reports/e2e_sample_output/recommendation.md", {
    title: "端到端示例输出（mock 数据，仅供结构预览）",
    description: "mock 网关在官方示例数据集上生成的推荐报告，用来看输出形态。",
  });
} catch {
  notCovered.push("reports/e2e_sample_output/recommendation.md 不存在（端到端未产出），未发布样例");
}

await artifact.markdown("phase1-report", mdLines.join("\n"), {
  title: "第一阶段开发报告",
  description: "基线交付情况、门禁结果、审计发现与下一步。",
  primary: true,
});

const result: WorkflowReport = {
  conclusion: gatesPassed
    ? `第一阶段基线完成：mock 端到端全链路（输入→抽取→渲染→回读→决策→校验）跑通并通过全部确定性门禁；独立审计 ${audit.findings.length} 项发现、${fixResult.fixed.length} 项已修复复验。代码已具备可提交形态的骨架（agent/ 入口 + agent.json）。下一步需要你提供 DASHSCOPE_API_KEY 进入第二阶段：真实模型联调、打包与首次提交。`
    : `第一阶段未完全达标：${compileOk ? "骨架编译通过但" : "骨架编译失败，且"}部分门禁三轮修复后仍未通过，具体失败见报告。已完成模块见模块清单，请先人工查看 reports/progress.md 与失败输出，再决定修复或回滚。`,
  findings: findingsOut,
  verified,
  notCovered,
};
return result;