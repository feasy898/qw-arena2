# -*- coding: utf-8 -*-
"""tools/benchmark.py — 抽取模型选型基准（第二阶段；本地工具，绝不打进提交包）。

任务：同一输入、同一 prompts 下对比候选抽取模型，为 config.example.json 的
default_model 选型提供数据（对比结论写 reports/model_comparison.md）。

方法（与生产链路完全同口径）：
- 画像抽取 1 次：src.profile_extractor.extract_profile_bundle(User_Description_{n} 原文)；
- 产品抽取 5 次：src.product_extractor.extract_products（逐产品 P001..P005，
  五源 SourceRecord 渲染与管线一致）；
- 每个候选模型独立 resolve_config 后仅覆盖 default_model（其余键与生产一致，
  含 request_timeout_seconds=300、enable_thinking=False 的真实联调校准）。

记录口径：
- 结构合法率：一次抽取操作（op）「首次模型应答」即 JSON 可解析且通过业务结构
  校验（未触发 chat_json 修复/空 content 降级重试、未触发 extract_* 业务修复
  重试、未抛 GatewayError）的比例；经重试才成功的 op 单列 pass_with_retry；
- 忠实度：与黄金夹具（tests/fixtures/gateway/responses.json 的 profile:user_{n} /
  products:P00X——第一阶段逐字核对过原文，作参照真值）的字段级自动比对：
  字段存在性（两侧同空/同非空）、取值一致（标量相等/数值集合相等/列表项集合
  相等/场景与需求多元组多重集相等）、fact_kind/status 枚举多重集一致、
  evidence_refs 的 source_id（及 span_id）集合一致；
  综合忠实度分 = (存在性 + 2×取值 + 证据) / 4（口径见报告正文）；
- 延迟：每次 chat() 调用墙钟（秒）；usage：每次调用的 prompt/completion tokens
  （按网关 usage_totals 差值记账，含空 content 等失败调用——token 已消耗）。

费用纪律（任务书）：每次调用后记账 usage 并汇总；任一模型累计 total tokens
超 TOKEN_STOP_LIMIT（200 万）立即停止不再发起调用；绝不打印 Key（env 优先，
其次 .secrets/，复用 tools/e2e_real.resolve_credentials）。

用法：
    python tools/benchmark.py --selfcheck            # 比对器自检（黄金 vs 黄金，离线零调用）
    python tools/benchmark.py                        # 全部候选模型实测并写报告
    python tools/benchmark.py --models qwen3.7-max   # 指定模型子集（逗号分隔）
"""
from __future__ import annotations

import argparse
import json
import logging
import os
import sys
import time
from collections import Counter
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from src.input_adapter import load_input
from src.model_gateway import GatewayError, ModelGateway
from src.pipeline import resolve_config
from src.product_extractor import (
    LIST_FIELDS,
    _field_keys,
    _normalize_product,
    extract_products,
)
from src.product_registry import build_registry
from src.profile_extractor import (
    LISTS,
    SCALARS,
    _normalize_profile,
    extract_profile_bundle,
)
from src.source_index import SourceIndex

DEFAULT_CANDIDATES = ("qwen3.6-plus", "qwen3.7-max", "deepseek-v4-flash")
DATA_POOL = REPO_ROOT / "raw" / "dataset_sample" / "Data_for_Users"
GOLDEN_FIXTURE_PATH = REPO_ROOT / "tests" / "fixtures" / "gateway" / "responses.json"
DEFAULT_REPORT_PATH = REPO_ROOT / "reports" / "model_comparison.md"
TOKEN_STOP_LIMIT = 2_000_000  # 任务书：任何单次完整运行 usage 超 200 万 tokens 立即停止

logger = logging.getLogger("qw.benchmark")


# ---------------------------------------------------------------------------
# 网关计时包装（记录每次 chat() 的墙钟与 usage 差值；其余行为不变）
# ---------------------------------------------------------------------------

class TimingGateway(ModelGateway):
    """ModelGateway 子类：逐调用记录（消息数, 耗时, 成败, usage 差值）。

    消息数用于区分调用形态：2 条=首次请求；3 条=chat_json 空 content 降级重试
    （前置 system 指令）；≥4 条=业务修复重试链。usage 取实例累计差值，
    空 content 等失败调用的已消耗 token 也如实入账。
    """

    def __init__(self, config: dict) -> None:
        super().__init__(config)
        self.calls: list[dict] = []

    def chat(self, messages: list[dict], model: str, *, mock_key=None) -> dict:
        before = self.usage_totals
        started = time.monotonic()
        error = None
        try:
            return super().chat(messages, model, mock_key=mock_key)
        except GatewayError as exc:
            error = type(exc).__name__
            raise
        finally:
            after = self.usage_totals
            self.calls.append({
                "n_messages": len(messages),
                "seconds": round(time.monotonic() - started, 2),
                "ok": error is None,
                "error": error,
                "prompt_tokens": after["prompt_tokens"] - before["prompt_tokens"],
                "completion_tokens": after["completion_tokens"] - before["completion_tokens"],
                "total_tokens": after["total_tokens"] - before["total_tokens"],
            })


# ---------------------------------------------------------------------------
# 抽取操作执行（与生产链路同函数、同 prompts）
# ---------------------------------------------------------------------------

def run_profile_op(gateway: TimingGateway, config: dict, user_text: str,
                   user_no: int) -> dict:
    started = time.monotonic()
    call_start = len(gateway.calls)
    op = {"op": f"profile:user_{user_no}", "kind": "profile", "ok": False,
          "error": None, "calls": [], "seconds": 0.0}
    try:
        profile, needs = extract_profile_bundle(user_text, gateway, config)
        op.update(ok=True, profile=profile, needs=needs)
    except GatewayError as exc:
        op["error"] = f"{type(exc).__name__}: {exc}"[:400]
        logger.error("画像抽取失败：%s", op["error"])
    op["seconds"] = round(time.monotonic() - started, 2)
    op["calls"] = gateway.calls[call_start:]
    return op


def run_product_op(gateway: TimingGateway, config: dict, record,
                   source_index: SourceIndex) -> dict:
    started = time.monotonic()
    call_start = len(gateway.calls)
    op = {"op": f"products:{record.canonical_id}", "kind": "product",
          "canonical_id": record.canonical_id, "ok": False, "error": None,
          "calls": [], "seconds": 0.0}
    try:
        drafts = extract_products([record], source_index, gateway, config)
        op.update(ok=True, draft=drafts[record.canonical_id])
    except GatewayError as exc:
        op["error"] = f"{type(exc).__name__}: {exc}"[:400]
        logger.error("产品 %s 抽取失败：%s", record.canonical_id, op["error"])
    op["seconds"] = round(time.monotonic() - started, 2)
    op["calls"] = gateway.calls[call_start:]
    return op


# ---------------------------------------------------------------------------
# 比对器（模型输出 vs 黄金夹具；两侧先过同一套归一化再比）
# ---------------------------------------------------------------------------

def _nonempty(value) -> bool:
    if value is None:
        return False
    if isinstance(value, str):
        return bool(value.strip())
    if isinstance(value, (list, dict, tuple, set)):
        return len(value) > 0
    return True


def _scalar_equal(m, g) -> bool:
    """标量相等：None 归一（空串视为缺失）；数值容差比较；字符串去空白比较。"""
    if isinstance(m, str) and not m.strip():
        m = None
    if isinstance(g, str) and not g.strip():
        g = None
    if m is None and g is None:
        return True
    if m is None or g is None:
        return False
    if isinstance(m, bool) or isinstance(g, bool):
        return m == g
    if isinstance(m, (int, float)) and isinstance(g, (int, float)):
        return abs(float(m) - float(g)) < 1e-9
    return str(m).strip() == str(g).strip()


def _jaccard(a: set, b: set) -> float:
    if not a and not b:
        return 1.0
    union = a | b
    return len(a & b) / len(union) if union else 1.0


def _obs_numbers(observations: list) -> set:
    values = set()
    for obs in observations or []:
        if not isinstance(obs, dict):
            continue
        normalized = obs.get("normalized_value")
        if isinstance(normalized, (int, float)) and not isinstance(normalized, bool):
            values.add(round(float(normalized), 6))
        elif isinstance(normalized, str):
            try:
                values.add(round(float(normalized.strip()), 6))
            except ValueError:
                pass
    return values


def _obs_raws(observations: list) -> Counter:
    counter = Counter()
    for obs in observations or []:
        if isinstance(obs, dict) and _nonempty(obs.get("raw_value")):
            counter[str(obs["raw_value"]).strip()] += 1
    return counter


def _obs_items(observations: list, list_field: bool) -> set:
    items = set()
    for obs in observations or []:
        if not isinstance(obs, dict):
            continue
        if list_field:
            items.update(str(i).strip() for i in obs.get("items") or [] if str(i).strip())
        elif _nonempty(obs.get("raw_value")):
            items.add(str(obs["raw_value"]).strip())
    return items


def _obs_kinds(observations: list) -> Counter:
    return Counter(str(o.get("fact_kind")) for o in observations or [] if isinstance(o, dict))


def _obs_statuses(observations: list) -> Counter:
    return Counter(str(o.get("status")) for o in observations or [] if isinstance(o, dict))


def _obs_evidence_sources(observations: list) -> set:
    sources = set()
    for obs in observations or []:
        if not isinstance(obs, dict):
            continue
        for ref in obs.get("evidence_refs") or []:
            if isinstance(ref, dict):
                sources.add((str(ref.get("source_id") or "").strip(),
                             str(ref.get("span_id") or "").strip()))
    return sources


def _obs_variants(observations: list) -> Counter:
    """battery_by_mode 条目签名：(适用模式, 归一数值)。"""
    counter = Counter()
    for obs in observations or []:
        if not isinstance(obs, dict):
            continue
        normalized = obs.get("normalized_value")
        if isinstance(normalized, (int, float)) and not isinstance(normalized, bool):
            value = round(float(normalized), 6)
        elif isinstance(normalized, str):
            try:
                value = round(float(normalized.strip()), 6)
            except ValueError:
                value = str(normalized).strip()
        else:
            value = None
        counter[(str(obs.get("applicable_variant") or "").strip(), value)] += 1
    return counter


def _value_match(field_key: str, m_obs: list, g_obs: list) -> tuple[bool, str]:
    """取值一致判定：数值集合相等（关键数值/等价区间口径）或原文值多重集相等；
    列表型字段比 items 并集；battery_by_mode 比（模式, 数值）多重集。"""
    if field_key == "battery_by_mode":
        return _obs_variants(m_obs) == _obs_variants(g_obs), "（模式,数值）多重集"
    if field_key in LIST_FIELDS:
        m_items = _obs_items(m_obs, True)
        g_items = _obs_items(g_obs, True)
        return m_items == g_items, f"items并集 Jaccard={_jaccard(m_items, g_items):.2f}"
    m_nums, g_nums = _obs_numbers(m_obs), _obs_numbers(g_obs)
    m_raws, g_raws = _obs_raws(m_obs), _obs_raws(g_obs)
    if m_nums or g_nums:
        if m_nums == g_nums:
            return True, "数值集合相等"
        return False, f"数值集合 {sorted(g_nums)}→{sorted(m_nums)}"
    return m_raws == g_raws, "原文值多重集"


def compare_profile(model_profile: dict, golden_profile: dict,
                    model_needs: list, golden_needs: list) -> dict:
    """画像字段级比对。返回 rows 与分项一致率。"""
    rows = []
    for key in SCALARS:
        m, g = model_profile.get(key), golden_profile.get(key)
        rows.append({
            "field": key, "group": "scalar",
            "presence": _nonempty(m) == _nonempty(g),
            "value": _scalar_equal(m, g),
            "golden_nonempty": _nonempty(g),
            "note": f"黄金={g!r} 模型={m!r}",
        })
    for key in LISTS:
        m_set = {str(i).strip() for i in (model_profile.get(key) or [])}
        g_set = {str(i).strip() for i in (golden_profile.get(key) or [])}
        rows.append({
            "field": key, "group": "list",
            "presence": bool(m_set) == bool(g_set),
            "value": m_set == g_set,
            "golden_nonempty": bool(g_set),
            "note": f"黄金={sorted(g_set)} 模型={sorted(m_set)} "
                    f"Jaccard={_jaccard(m_set, g_set):.2f}",
        })
    m_scenes = {(str(s.get("scene_name") or "").strip(),
                 str(s.get("usage_duration") or "").strip(),
                 str(s.get("usage_frequency") or "").strip(),
                 s.get("scene_priority"),
                 str(s.get("priority_basis") or "").strip())
                for s in (model_profile.get("scenes") or []) if isinstance(s, dict)}
    g_scenes = {(str(s.get("scene_name") or "").strip(),
                 str(s.get("usage_duration") or "").strip(),
                 str(s.get("usage_frequency") or "").strip(),
                 s.get("scene_priority"),
                 str(s.get("priority_basis") or "").strip())
                for s in (golden_profile.get("scenes") or []) if isinstance(s, dict)}
    rows.append({
        "field": "scenes", "group": "scenes",
        "presence": bool(m_scenes) == bool(g_scenes),
        "value": m_scenes == g_scenes,
        "golden_nonempty": bool(g_scenes),
        "note": f"黄金={sorted(g_scenes)} 模型={sorted(m_scenes)}",
    })
    m_needs_sig = Counter((n.original_expression, n.need_type.value) for n in model_needs)
    g_needs_sig = Counter((n.original_expression, n.need_type.value) for n in golden_needs)
    rows.append({
        "field": "needs", "group": "needs",
        "presence": bool(model_needs) == bool(golden_needs),
        "value": m_needs_sig == g_needs_sig,
        "golden_nonempty": bool(golden_needs),
        "note": f"黄金{len(golden_needs)}条 模型{len(model_needs)}条；"
                f"表达式∩类型一致率={_jaccard(set(m_needs_sig), set(g_needs_sig)):.2f}",
    })
    # 需求证据定位率：逐字引文能回溯到原文行片段的比例（evidence_refs 非空）
    located = sum(1 for n in model_needs if n.evidence_refs)
    g_located = sum(1 for n in golden_needs if n.evidence_refs)
    golden_nonempty = [r for r in rows if r["golden_nonempty"]]
    return {
        "rows": rows,
        "presence_rate": sum(r["presence"] for r in rows) / len(rows),
        "value_rate": (sum(r["value"] for r in golden_nonempty) / len(golden_nonempty)
                       if golden_nonempty else 1.0),
        "evidence_rate": located / len(model_needs) if model_needs else 0.0,
        "evidence_note": f"黄金需求引文定位 {g_located}/{len(golden_needs)}；"
                         f"模型 {located}/{len(model_needs)}",
    }


def compare_product(model_draft: dict, golden_draft: dict, field_keys: list) -> dict:
    """单产品字段级比对（field_keys 为 field_catalog 产品字段键；身份字段单列）。"""
    rows = []
    for key in field_keys:
        m_obs = model_draft.get(key) or []
        g_obs = golden_draft.get(key) or []
        presence = bool(m_obs) == bool(g_obs)
        golden_nonempty = bool(g_obs)
        if not golden_nonempty and not m_obs:
            rows.append({"field": key, "presence": True, "value": True,
                         "kind": True, "status": True, "evidence_source": True,
                         "evidence_span": True, "golden_nonempty": False,
                         "note": "两侧同空"})
            continue
        value, note = _value_match(key, m_obs, g_obs)
        rows.append({
            "field": key,
            "presence": presence,
            "value": value,
            "kind": _obs_kinds(m_obs) == _obs_kinds(g_obs),
            "status": _obs_statuses(m_obs) == _obs_statuses(g_obs),
            "evidence_source": ({s for s, _ in _obs_evidence_sources(m_obs)}
                                == {s for s, _ in _obs_evidence_sources(g_obs)}),
            "evidence_span": _obs_evidence_sources(m_obs) == _obs_evidence_sources(g_obs),
            "golden_nonempty": golden_nonempty,
            "note": note,
        })
    # 身份字段（模型给值经身份兼容校验，registry 兜底）
    for key in ("product_name", "brand", "model"):
        m, g = model_draft.get(key), golden_draft.get(key)
        rows.append({
            "field": f"(身份){key}", "presence": _nonempty(m) == _nonempty(g),
            "value": _scalar_equal(m, g), "kind": True, "status": True,
            "evidence_source": True, "evidence_span": True,
            "golden_nonempty": _nonempty(g),
            "note": f"黄金={g!r} 模型={m!r}",
        })
    nonempty_rows = [r for r in rows if r["golden_nonempty"]]
    return {
        "rows": rows,
        "presence_rate": sum(r["presence"] for r in rows) / len(rows),
        "value_rate": (sum(r["value"] for r in nonempty_rows) / len(nonempty_rows)
                       if nonempty_rows else 1.0),
        "kind_rate": (sum(r["kind"] for r in nonempty_rows) / len(nonempty_rows)
                      if nonempty_rows else 1.0),
        "status_rate": (sum(r["status"] for r in nonempty_rows) / len(nonempty_rows)
                        if nonempty_rows else 1.0),
        "evidence_source_rate": (sum(r["evidence_source"] for r in nonempty_rows)
                                 / len(nonempty_rows) if nonempty_rows else 1.0),
        "evidence_span_rate": (sum(r["evidence_span"] for r in nonempty_rows)
                               / len(nonempty_rows) if nonempty_rows else 1.0),
    }


def op_faithfulness(op: dict, comparison: dict) -> float:
    """综合忠实度分 =（存在性 + 2×取值 + 证据定位） / 4（报告正文注明口径）。"""
    return (comparison["presence_rate"] + 2 * comparison["value_rate"]
            + comparison["evidence_rate" if op["kind"] == "profile" else "evidence_source_rate"]) / 4


# ---------------------------------------------------------------------------
# 黄金夹具装载（与模型输出同口径归一化）
# ---------------------------------------------------------------------------

def load_golden(user_no: int, user_text: str, registry, source_index: SourceIndex) -> dict:
    if not GOLDEN_FIXTURE_PATH.is_file():
        raise SystemExit(f"黄金夹具缺失：{GOLDEN_FIXTURE_PATH}")
    with open(GOLDEN_FIXTURE_PATH, encoding="utf-8") as handle:
        fixture = json.load(handle)
    profile_key = f"profile:user_{user_no}"
    if profile_key not in fixture:
        raise SystemExit(f"黄金夹具缺少键：{profile_key}")
    parsed = json.loads(fixture[profile_key]["content"])
    golden_profile, golden_needs, problems = _normalize_profile(parsed, user_text)
    if problems:
        raise SystemExit(f"黄金画像归一化异常（不应发生）：{problems[:3]}")
    golden_products = {}
    for record in registry.all():
        key = f"products:{record.canonical_id}"
        if key not in fixture:
            raise SystemExit(f"黄金夹具缺少键：{key}")
        parsed = json.loads(fixture[key]["content"])
        records_by_id = {r.source_id: r for r in source_index.by_product(record.canonical_id)}
        draft, problems = _normalize_product(parsed, record, records_by_id)
        if problems:
            raise SystemExit(f"黄金产品 {record.canonical_id} 归一化异常（不应发生）：{problems[:3]}")
        golden_products[record.canonical_id] = draft
    return {"profile": golden_profile, "needs": golden_needs,
            "products": golden_products}


# ---------------------------------------------------------------------------
# 单模型评测
# ---------------------------------------------------------------------------

def evaluate_model(model: str, user_no: int, user_text: str, registry,
                   source_index: SourceIndex, golden: dict, field_keys: list) -> dict:
    config = resolve_config()
    config["default_model"] = model  # 仅覆盖模型字段；其余键与生产一致
    gateway = TimingGateway(config)
    result = {"model": model, "ops": [], "calls": [], "error": None}
    started = time.monotonic()

    profile_op = run_profile_op(gateway, config, user_text, user_no)
    result["ops"].append(profile_op)
    if profile_op["ok"]:
        comparison = compare_profile(profile_op["profile"], golden["profile"],
                                     profile_op["needs"], golden["needs"])
        profile_op["comparison"] = comparison
        profile_op["faithfulness"] = op_faithfulness(profile_op, comparison)

    for record in sorted(registry.all(), key=lambda r: r.canonical_id):
        product_op = run_product_op(gateway, config, record, source_index)
        result["ops"].append(product_op)
        if product_op["ok"]:
            comparison = compare_product(product_op["draft"],
                                         golden["products"][record.canonical_id],
                                         field_keys)
            product_op["comparison"] = comparison
            product_op["faithfulness"] = op_faithfulness(product_op, comparison)

        total = gateway.usage_totals["total_tokens"]
        if total > TOKEN_STOP_LIMIT:
            result["error"] = (f"usage={total} 超过停止线 {TOKEN_STOP_LIMIT}，"
                               "立即停止（任务书费用纪律）")
            break

    result["seconds_total"] = round(time.monotonic() - started, 2)
    result["calls"] = list(gateway.calls)
    result["usage"] = gateway.usage_totals

    ok_ops = [op for op in result["ops"] if op["ok"]]
    first_try_ops = [op for op in ok_ops if len(op["calls"]) == 1]
    result["structure_first_pass"] = len(first_try_ops) / len(result["ops"]) if result["ops"] else 0.0
    result["structure_pass_with_retry"] = len(ok_ops) / len(result["ops"]) if result["ops"] else 0.0
    faith_ops = [op for op in result["ops"] if op.get("faithfulness") is not None]
    result["faithfulness"] = (sum(op["faithfulness"] for op in faith_ops) / len(faith_ops)
                              if faith_ops else 0.0)
    per_call = [c["seconds"] for c in result["calls"]]
    result["latency_avg"] = round(sum(per_call) / len(per_call), 1) if per_call else None
    result["latency_max"] = max(per_call) if per_call else None
    return result


# ---------------------------------------------------------------------------
# 报告
# ---------------------------------------------------------------------------

def _fmt_pct(value) -> str:
    return f"{value * 100:.1f}%"


def render_report(results: list[dict], user_no: int, field_keys: list,
                  totals: dict) -> str:
    lines = []
    lines.append("# reports/model_comparison.md — 抽取模型选型对比（第二阶段）")
    lines.append("")
    lines.append(f"- 生成：tools/benchmark.py（{time.strftime('%Y-%m-%d %H:%M')}），"
                 f"基准输入 raw/dataset_sample/Data_for_Users 的 User_Description_{user_no} "
                 "与 P001..P005 五源资料")
    lines.append("- 黄金参照：tests/fixtures/gateway/responses.json 的 profile:user_%d 与 "
                 "products:P001..P005（第一阶段逐字核对过原文的忠实抽取，作参照真值）"
                 % user_no)
    lines.append("- 方法：每模型画像抽取 1 次 + 产品抽取 5 次，与生产链路同函数同 prompts"
                 "（src/profile_extractor.py、src/product_extractor.py），仅覆盖 "
                 "config.default_model；其余配置与生产一致（request_timeout_seconds=300、"
                 "enable_thinking=False）")
    lines.append("- 口径：**结构合法**=首次应答即 JSON 可解析且过业务结构校验（无任何重试）；"
                 "**忠实度分**=（字段存在性 + 2×字段取值 + 证据定位）÷4，其中取值一致率只在"
                 "黄金非空字段上计（数值字段按数值集合相等=等价区间口径，列表按 items 并集，"
                 "续航按（模式,数值）多重集），证据定位=evidence_refs 的 source_id 集合一致"
                 "（画像侧为需求逐字引文回溯原文行片段的比例）；延迟/usage 为每次 chat() 调用"
                 "实测（usage 含失败调用已消耗 token）")
    lines.append("")
    lines.append("## 1. 对比总表")
    lines.append("")
    lines.append("| 模型 | 结构合法率（首答） | 含重试成功率 | 忠实度分 | 画像取值一致 | 产品取值一致 | "
                 "证据 source 一致 | 平均/最大单调用延迟 | usage（prompt/completion/总 tokens） |")
    lines.append("|---|---|---|---|---|---|---|---|---|")
    for r in results:
        profile_rows = [op for op in r["ops"] if op["kind"] == "profile" and op.get("comparison")]
        product_rows = [op for op in r["ops"] if op["kind"] == "product" and op.get("comparison")]
        pv = profile_rows[0]["comparison"]["value_rate"] if profile_rows else None
        prod_v = (sum(op["comparison"]["value_rate"] for op in product_rows) / len(product_rows)
                  if product_rows else None)
        ev = (sum(op["comparison"].get("evidence_source_rate", 0) for op in product_rows)
              / len(product_rows) if product_rows else None)
        usage = r["usage"]
        lines.append(
            f"| `{r['model']}` | {_fmt_pct(r['structure_first_pass'])} "
            f"（{int(r['structure_first_pass'] * len(r['ops']))}/{len(r['ops'])}） "
            f"| {_fmt_pct(r['structure_pass_with_retry'])} "
            f"| {r['faithfulness']:.3f} "
            f"| {_fmt_pct(pv) if pv is not None else '—（抽取失败）'} "
            f"| {_fmt_pct(prod_v) if prod_v is not None else '—（抽取失败）'} "
            f"| {_fmt_pct(ev) if ev is not None else '—（抽取失败）'} "
            f"| {r['latency_avg']}s / {r['latency_max']}s "
            f"| {usage['prompt_tokens']} / {usage['completion_tokens']} / {usage['total_tokens']} |")
    lines.append("")

    lines.append("## 2. 分模型明细")
    lines.append("")
    for r in results:
        lines.append(f"### `{r['model']}`")
        lines.append("")
        lines.append("| 操作 | 结果 | 调用次数 | 首答通过 | 墙钟 | 忠实度分 | 说明 |")
        lines.append("|---|---|---|---|---|---|---|")
        for op in r["ops"]:
            call_count = len(op["calls"])
            first_try = op["ok"] and call_count == 1
            note = "—"
            if not op["ok"]:
                note = (op.get("error") or "未知错误")[:120]
            elif op["kind"] == "profile" and op.get("comparison"):
                note = op["comparison"]["evidence_note"]
            lines.append(
                f"| {op['op']} | {'成功' if op['ok'] else '失败'} | {call_count} "
                f"| {'是' if first_try else '否'} | {op['seconds']}s "
                f"| {op.get('faithfulness') if op.get('faithfulness') is not None else '—'} "
                f"| {note} |")
        lines.append("")
        failed_fields = []
        for op in r["ops"]:
            comparison = op.get("comparison")
            if not comparison:
                continue
            for row in comparison["rows"]:
                if not row.get("golden_nonempty", False):
                    continue  # 黄金同空字段不计入差异清单（存在性口径已在一致率中体现）
                problems = [name for name in ("presence", "value", "kind", "status",
                                              "evidence_source") if row.get(name, True) is False]
                if problems:
                    failed_fields.append(
                        f"- {op['op']} · {row['field']}：{'/'.join(problems)}"
                        f"（{row['note']}）")
        if failed_fields:
            lines.append("与黄金参照不一致的字段（golden 非空字段）：")
            lines.extend(failed_fields[:40])
            if len(failed_fields) > 40:
                lines.append(f"- …（其余 {len(failed_fields) - 40} 条略）")
        else:
            lines.append("与黄金参照不一致的字段：无（golden 非空字段全部一致）")
        lines.append("")

    lines.append("## 3. usage 汇总与费用纪律")
    lines.append("")
    grand_prompt = sum(r["usage"]["prompt_tokens"] for r in results)
    grand_completion = sum(r["usage"]["completion_tokens"] for r in results)
    grand_total = sum(r["usage"]["total_tokens"] for r in results)
    grand_requests = sum(r["usage"]["requests"] for r in results)
    lines.append(f"- 本次基准合计：{grand_requests} 次 API 请求（含重试），"
                 f"prompt={grand_prompt}，completion={grand_completion}，"
                 f"total={grand_total} tokens；未超 200 万 tokens 停止线" if grand_total <= TOKEN_STOP_LIMIT else
                 f"- !! 本次基准合计 total={grand_total} tokens 已超 200 万停止线")
    lines.append(f"- 各模型请求数：{ {r['model']: r['usage']['requests'] for r in results} }")
    lines.append("- 计价口径说明：平台未在本地契约提供各模型单价，成本以 tokens 计；"
                 "单价差异需以平台牌价折算（未提供，待核验）")
    lines.append("")
    lines.append("## 4. 结论")
    lines.append("")
    lines.append("（见下方向量化结论段——由选型评估员依据上表数据填写）")
    lines.append("")
    return "\n".join(lines)


def _totals_of(results: list[dict]) -> dict:
    return {
        "prompt_tokens": sum(r["usage"]["prompt_tokens"] for r in results),
        "completion_tokens": sum(r["usage"]["completion_tokens"] for r in results),
        "total_tokens": sum(r["usage"]["total_tokens"] for r in results),
        "requests": sum(r["usage"]["requests"] for r in results),
    }


def _json_default(obj):
    """结果 JSON 序列化兜底（UserNeed/EvidenceRef 等 dataclass 与枚举）。"""
    import dataclasses
    import enum
    if dataclasses.is_dataclass(obj):
        return dataclasses.asdict(obj)
    if isinstance(obj, enum.Enum):
        return obj.value
    if isinstance(obj, set):
        return sorted(str(item) for item in obj)
    return str(obj)


def save_results(results: list[dict], user_no: int) -> Path:
    """原始结果落盘（每个模型完成即增量保存；报告渲染崩溃后可 --from-json 回放，
    不再消耗 API 调用）。存 reports/logs/benchmark/（AGENTS.md §10 日志目录口径）。"""
    out_dir = REPO_ROOT / "reports" / "logs" / "benchmark"
    out_dir.mkdir(parents=True, exist_ok=True)
    path = out_dir / f"benchmark_results_user{user_no}.json"
    payload = {"user": user_no, "saved_at": time.strftime("%Y-%m-%d %H:%M:%S"),
               "results": results}
    path.write_text(json.dumps(payload, ensure_ascii=False, indent=1, default=_json_default),
                    encoding="utf-8")
    return path


def load_results(path: Path) -> list[dict]:
    """回放已保存的原始结果（--from-json；不发起任何 API 调用）。"""
    with open(path, encoding="utf-8") as handle:
        payload = json.load(handle)
    if not isinstance(payload, dict) or not isinstance(payload.get("results"), list):
        raise SystemExit(f"回放文件格式非法：{path}")
    return payload["results"]


# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

def _setup_logging() -> Path:
    base = os.environ.get("AGENT_LOG_DIR") or str(REPO_ROOT / "reports" / "logs")
    log_dir = Path(base) / "benchmark"
    log_dir.mkdir(parents=True, exist_ok=True)
    log_path = log_dir / "benchmark.log"
    root = logging.getLogger()
    root.setLevel(logging.INFO)
    if not any(isinstance(h, logging.FileHandler)
               and os.path.abspath(getattr(h, "baseFilename", ""))
               == os.path.abspath(str(log_path))
               for h in root.handlers):
        handler = logging.FileHandler(log_path, encoding="utf-8")
        handler.setFormatter(logging.Formatter(
            "%(asctime)s | %(levelname)s | %(name)s | %(message)s"))
        root.addHandler(handler)
    return log_path


def _build_context(user_no: int):
    """装载输入池 + 黄金夹具（零 API 调用）。返回 (user_text, registry, source_index, golden)。"""
    bundle_in = load_input(DATA_POOL)
    user_file = DATA_POOL / "00_User_Descriptions" / f"User_Description_{user_no}.txt"
    if not user_file.is_file():
        raise SystemExit(f"用户描述不存在：{user_file}")
    user_text = user_file.read_text(encoding="utf-8-sig")
    registry = build_registry(bundle_in.source_records)
    source_index = SourceIndex(bundle_in.source_records)
    golden = load_golden(user_no, user_text, registry, source_index)
    return user_text, registry, source_index, golden


def selfcheck(user_no: int) -> int:
    """比对器自检：黄金 vs 黄金，全部一致率必须为 1.0（离线零调用）。"""
    _setup_logging()
    user_text, registry, source_index, golden = _build_context(user_no)
    profile_cmp = compare_profile(golden["profile"], golden["profile"],
                                  golden["needs"], golden["needs"])
    field_keys = _field_keys()
    bad = []
    if profile_cmp["presence_rate"] != 1.0 or profile_cmp["value_rate"] != 1.0:
        bad.append(f"profile presence={profile_cmp['presence_rate']} "
                   f"value={profile_cmp['value_rate']}")
        bad.extend(f"  profile:{r['field']} {r['note']}" for r in profile_cmp["rows"]
                   if not (r["presence"] and r["value"]))
    for record in sorted(registry.all(), key=lambda r: r.canonical_id):
        g = golden["products"][record.canonical_id]
        cmp_result = compare_product(g, g, field_keys)
        if (cmp_result["presence_rate"] != 1.0 or cmp_result["value_rate"] != 1.0
                or cmp_result["evidence_source_rate"] != 1.0):
            bad.append(f"{record.canonical_id} presence={cmp_result['presence_rate']} "
                       f"value={cmp_result['value_rate']}")
            bad.extend(f"  {record.canonical_id}:{r['field']} {r['note']}"
                       for r in cmp_result["rows"]
                       if not (r["presence"] and r["value"] and r["evidence_source"]))
    if bad:
        print("SELFCHECK FAILED（比对器与自身黄金夹具不一致，比对器有缺陷）：")
        print("\n".join(bad[:50]))
        return 1
    print("SELFCHECK PASSED：黄金 vs 黄金 全部一致率=1.0（比对器口径自洽）")
    return 0


def main(argv: list[str] | None = None) -> int:
    try:
        sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    except (AttributeError, ValueError):
        pass
    parser = argparse.ArgumentParser(description="抽取模型选型基准（本地工具）")
    parser.add_argument("--models", default=",".join(DEFAULT_CANDIDATES),
                        help="逗号分隔的候选模型（须在白名单内）")
    parser.add_argument("--user", type=int, default=1,
                        help="用户描述编号 n（黄金夹具仅 user_1，默认 1）")
    parser.add_argument("--report", default=str(DEFAULT_REPORT_PATH),
                        help="对比报告输出路径（默认 reports/model_comparison.md）")
    parser.add_argument("--selfcheck", action="store_true",
                        help="只跑比对器自检（黄金 vs 黄金，零 API 调用）后退出")
    parser.add_argument("--from-json", default=None,
                        help="从已保存的原始结果 JSON 回放并重新渲染报告（零 API 调用）")
    parser.add_argument("--token-cap", type=int, default=500_000,
                        help="本次基准全程累计 usage 上限（tokens，默认 50 万；费用纪律）")
    args = parser.parse_args(argv)

    log_path = _setup_logging()
    if args.selfcheck:
        return selfcheck(args.user)

    if args.from_json:
        results = load_results(Path(args.from_json))
        field_keys = _field_keys()
        totals = _totals_of(results)
        report_path = Path(args.report)
        report_path.write_text(render_report(results, results[0].get("user", args.user),
                                             field_keys, totals), encoding="utf-8")
        print(f"[benchmark] 回放完成（零 API 调用），报告：{report_path}")
        print(json.dumps({"report": str(report_path), "models": len(results),
                          "totals": totals}, ensure_ascii=False, indent=2))
        return 0

    models = [m.strip() for m in args.models.split(",") if m.strip()]
    whitelist = None
    from src.model_gateway import load_model_whitelist
    whitelist = load_model_whitelist()
    for model in models:
        if model not in whitelist:
            print(f"模型 {model} 不在白名单内，拒绝运行")
            return 1

    # 凭据：env 优先，其次 .secrets（复用 e2e_real 口径；绝不打印 Key）
    from tools.e2e_real import resolve_credentials
    api_key, base_url = resolve_credentials()
    os.environ["DASHSCOPE_API_KEY"] = api_key
    os.environ["OPENAI_BASE_URL"] = base_url

    user_text, registry, source_index, golden = _build_context(args.user)
    field_keys = _field_keys()
    print(f"[benchmark] 输入：User_Description_{args.user} + P001..P005 五源；"
          f"候选模型：{models}；日志：{log_path}")
    logger.info("基准开始 models=%s user=%s", models, args.user)

    results = []
    saved_path = None
    token_cap = args.token_cap
    for index, model in enumerate(models, 1):
        if index > 1 and _totals_of(results)["total_tokens"] > token_cap:
            print(f"[benchmark] !! 累计 usage={_totals_of(results)['total_tokens']} "
                  f"已超本次基准上限 {token_cap} tokens，停止继续评测（费用纪律）")
            break
        print(f"[benchmark] ({index}/{len(models)}) 评测 {model} …")
        result = evaluate_model(model, args.user, user_text, registry,
                                source_index, golden, field_keys)
        results.append(result)
        saved_path = save_results(results, args.user)  # 每模型增量落盘（崩溃可回放）
        usage = result["usage"]
        print(f"[benchmark] {model} 完成：结构首答合法率="
              f"{result['structure_first_pass'] * 100:.1f}% 忠实度={result['faithfulness']:.3f} "
              f"延迟均/峰={result['latency_avg']}s/{result['latency_max']}s "
              f"usage prompt={usage['prompt_tokens']} completion={usage['completion_tokens']} "
              f"total={usage['total_tokens']} requests={usage['requests']}")
        if result["error"]:
            print(f"[benchmark] !! {result['error']}")
            break

    totals = _totals_of(results)
    report_path = Path(args.report)
    report_path.parent.mkdir(parents=True, exist_ok=True)
    summary = {
        "report": str(report_path),
        "raw_results": str(saved_path) if saved_path else None,
        "models": [{
            "model": r["model"],
            "structurePass": f"{r['structure_first_pass'] * 100:.1f}%（首答）；"
                             f"{r['structure_pass_with_retry'] * 100:.1f}%（含重试）",
            "faithfulness": f"{r['faithfulness']:.3f}",
            "latencyUsage": (f"平均 {r['latency_avg']}s / 最大 {r['latency_max']}s；"
                             f"prompt={r['usage']['prompt_tokens']} "
                             f"completion={r['usage']['completion_tokens']} "
                             f"total={r['usage']['total_tokens']} tokens "
                             f"requests={r['usage']['requests']}"),
        } for r in results],
        "totals": totals,
    }
    # 先打印汇总再渲染报告：即使渲染缺陷也不会再丢失实测数据（另有原始结果落盘）
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    report_path.write_text(render_report(results, args.user, field_keys, totals),
                           encoding="utf-8")
    print(f"[benchmark] 原始结果已保存：{saved_path}")
    print(f"[benchmark] 报告：{report_path}")
    logger.info("基准完成 totals=%s", totals)
    return 0


if __name__ == "__main__":
    sys.exit(main())
