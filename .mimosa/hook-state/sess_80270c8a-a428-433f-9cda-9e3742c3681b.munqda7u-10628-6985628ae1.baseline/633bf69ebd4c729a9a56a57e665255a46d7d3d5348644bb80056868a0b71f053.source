# 从本机 Edge 配置解密指定域名的 Cookie，保存到本地 JSON（值不打印到 stdout）。
# 用法: python decrypt_edge_cookies.py <输出json路径>
import base64
import ctypes
import ctypes.wintypes as wt
import json
import os
import shutil
import sqlite3
import sys
import tempfile

EDGE_USER_DATA = os.path.expandvars(r"%LOCALAPPDATA%\Microsoft\Edge\User Data")
DOMAIN_FILTERS = ("qianwenai", "aliyun.com")


class DATA_BLOB(ctypes.Structure):
    _fields_ = [("cbData", wt.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]


def dpapi_decrypt(data: bytes) -> bytes:
    buf = ctypes.create_string_buffer(data, len(data))
    blob_in = DATA_BLOB(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char)))
    blob_out = DATA_BLOB()
    ok = ctypes.windll.crypt32.CryptUnprotectData(
        ctypes.byref(blob_in), None, None, None, None, 0, ctypes.byref(blob_out)
    )
    if not ok:
        raise OSError("CryptUnprotectData failed")
    out = ctypes.string_at(blob_out.pbData, blob_out.cbData)
    ctypes.windll.kernel32.LocalFree(blob_out.pbData)
    return out


def get_aes_key(user_data_dir: str) -> bytes:
    with open(os.path.join(user_data_dir, "Local State"), "r", encoding="utf-8") as f:
        local_state = json.load(f)
    enc_key = base64.b64decode(local_state["os_crypt"]["encrypted_key"])
    assert enc_key.startswith(b"DPAPI"), "unexpected key prefix"
    return dpapi_decrypt(enc_key[5:])


def decrypt_cookie(enc: bytes, aes_key: bytes):
    if not enc:
        return None
    ver = enc[:3]
    try:
        if ver in (b"v10", b"v11"):
            nonce, ct, tag = enc[3:15], enc[15:-16], enc[-16:]
            from Crypto.Cipher import AES
            cipher = AES.new(aes_key, AES.MODE_GCM, nonce=nonce)
            return cipher.decrypt_and_verify(ct, tag)
        if ver == b"v20":
            # app-bound 加密，DPAPI 不够；先跳过
            return None
        return dpapi_decrypt(enc)
    except Exception:
        return None


def main():
    out_path = sys.argv[1]
    aes_key = get_aes_key(EDGE_USER_DATA)
    cookies = []
    profiles = [
        d for d in os.listdir(EDGE_USER_DATA)
        if d == "Default" or (d.startswith("Profile") and os.path.isdir(os.path.join(EDGE_USER_DATA, d)))
    ]
    for profile in profiles:
        db = os.environ.get("EDGE_COOKIES_DB") or os.path.join(EDGE_USER_DATA, profile, "Network", "Cookies")
        if not os.path.exists(db):
            continue
        tmp = os.path.join(tempfile.gettempdir(), f"cookies_{profile}.db")
        try:
            shutil.copy2(db, tmp)
        except PermissionError:
            r = os.system(f'esentutl /y "{db}" /d "{tmp}" /o >nul 2>&1')
            if r != 0 or not os.path.exists(tmp):
                raise
        # WAL 可能含最新数据，一并拷贝
        for ext in ("-wal", "-shm"):
            if os.path.exists(db + ext):
                shutil.copy2(db + ext, tmp + ext)
        con = sqlite3.connect(tmp)
        try:
            rows = con.execute(
                "SELECT host_key, name, encrypted_value, path, expires_utc, "
                "is_httponly, is_secure FROM cookies"
            ).fetchall()
        finally:
            con.close()
        n_hit = 0
        for host, name, enc, path, exp, httponly, secure in rows:
            if not any(f in (host or "") for f in DOMAIN_FILTERS):
                continue
            val = decrypt_cookie(enc, aes_key)
            if val is None:
                cookies.append({"profile": profile, "domain": host, "name": name,
                                "value": None, "undecryptable": True})
                continue
            n_hit += 1
            cookies.append({
                "profile": profile, "domain": host, "name": name,
                "value": val.decode("utf-8", "replace"),
                "path": path, "expires_utc": exp,
                "httpOnly": bool(httponly), "secure": bool(secure),
            })
        print(f"[{profile}] matched cookies: {n_hit}")
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        json.dump(cookies, f, ensure_ascii=False, indent=1)
    print(f"saved -> {out_path} ({len(cookies)} cookies)")
    # 摘要：只打印域名/名称/长度，不打印值
    for c in cookies:
        vlen = len(c["value"]) if c.get("value") else 0
        print(f"  {c['domain']:35s} {c['name']:30s} len={vlen}"
              + ("  [UNDECRYPTABLE]" if c.get("undecryptable") else ""))


if __name__ == "__main__":
    main()
