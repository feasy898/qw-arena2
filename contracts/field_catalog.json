{
  "version": "0.1.0",
  "purpose": "user_profile.md 与 product_list.md 的唯一字段口径：同字段集、同顺序、同表头、同缺失表达。渲染器与解析器、画像/产品抽取 Prompt、validators 均以本目录为准。",
  "sources_of_truth": [
    "raw/competition-problemData.txt（输出要求：画像7字段组 / 产品5字段组；评分维度 U1-U4 / P1-P6 / R1-R4）",
    "SPEC.md §4/§6/§7/§8/§9/§10",
    "raw/dataset_sample/Data_for_Users/（逐文件核对，见 meta.verified_against）"
  ],
  "common": {
    "table_columns": ["字段组", "字段名", "取值"],
    "types": {
      "文本": "自由文本，保留原文限定词（约/最长/最高等）",
      "数字": "纯数值，可带小数；单位由 unit 列约束，写在取值中时保留原单位表述",
      "区间": "下限-上限（如 699-999）；允许退化为单值（须注明口径，如「展示价1098元」）",
      "枚举": "取值限于 enum 列表",
      "列表": "多个原子项；结构化列表按 item_fields 逐项展开为独立表格行"
    },
    "missing_values": {
      "未提供": "输入资料对该子字段完全无信息",
      "待核验": "资料有相关表述但无统一口径，或仅宣传性/待证实表述；须附简短条件说明"
    },
    "missing_selection_rule": "先判「未提供」（资料完全无信息）；仅当资料存在相关表述但不满足采信条件时用「待核验」。二者不得混用、不得用 N/A、-、空串等替代。",
    "row_policy": "同一文档内所有行的字段名与顺序完全一致（官方要求所有产品表格结构完全一致）。required=false 仅表示该值允许为缺失表达，不表示可省略表格行。",
    "verbatim_rule": "品牌与型号原样沿用脱敏名，不替换、不简写、不还原；数字保留原文精度与「约/最长」等限定词。",
    "citation_format": {
      "profile": "画像｜{字段组}｜{字段名}",
      "product": "产品属性｜{产品编号}｜{字段名}",
      "scope": "recommendation.md 中的引用只允许指向前两份文档内出现的字段，不得越界引用原始资料"
    }
  },
  "profile": {
    "document": "user_profile.md",
    "table_columns": ["字段组", "字段名", "取值"],
    "groups": [
      {
        "name": "标识",
        "scoring": ["U4"],
        "fields": [
          {
            "key": "profile_id",
            "name": "画像编号",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "取输入文件名编号：User_Description_{n}（n 为文件名中的数字）",
            "scoring": ["U4"]
          }
        ]
      },
      {
        "name": "基本情况",
        "scoring": ["U1", "U3", "U4"],
        "fields": [
          {
            "key": "name",
            "name": "称谓",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "原文称谓原样（如「小王」「陈女士」）",
            "scoring": ["U1"]
          },
          {
            "key": "gender",
            "name": "性别",
            "type": "枚举",
            "enum": ["男", "女", "未提供"],
            "unit": null,
            "missing": "未提供",
            "required": true,
            "scoring": ["U1"]
          },
          {
            "key": "age",
            "name": "年龄",
            "type": "数字",
            "unit": "岁",
            "missing": "未提供",
            "required": true,
            "scoring": ["U1"]
          },
          {
            "key": "occupation",
            "name": "职业",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "不作上位概念简化，保留原文表述（如「大二学生」不写「学生」）",
            "scoring": ["U1"]
          },
          {
            "key": "city",
            "name": "所在城市/地区",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "scoring": ["U1"]
          }
        ]
      },
      {
        "name": "购买目标",
        "scoring": ["U1", "U4"],
        "fields": [
          {
            "key": "product_category",
            "name": "商品品类",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原文品类词（如「耳机」），不做上位/下位改写",
            "scoring": ["U1"]
          },
          {
            "key": "desired_product_type",
            "name": "期望产品类型/形态",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "原文明确的具体类型（如「头戴式游戏耳机」「能在水下听歌的耳机」）",
            "scoring": ["U1", "R1"]
          },
          {
            "key": "purchase_purposes",
            "name": "购买目的",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原子化逐条列出，每条可独立核验；禁止概括成标签（如「重度通勤用户」）",
            "scoring": ["U1"]
          }
        ]
      },
      {
        "name": "预算",
        "scoring": ["U1", "R1"],
        "fields": [
          {
            "key": "budget_min",
            "name": "预算下限",
            "type": "数字",
            "unit": "元",
            "missing": "未提供",
            "required": false,
            "scoring": ["U1"]
          },
          {
            "key": "budget_max",
            "name": "预算上限",
            "type": "数字",
            "unit": "元",
            "missing": "未提供",
            "required": true,
            "value_rule": "「约X左右」时仍取 X 为数值，口径记入 budget_semantics，不得直接当硬上限",
            "scoring": ["U1"]
          },
          {
            "key": "currency",
            "name": "币种",
            "type": "枚举",
            "enum": ["元", "未提供"],
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原文以「元」计价时记「元」；原文未提币种时「未提供」，不得按常识补 CNY",
            "scoring": ["U1"]
          },
          {
            "key": "budget_raw",
            "name": "预算原文表述",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "逐字保留（如「预算2000元左右」「大概在1500-2000元之间」），供溯源",
            "scoring": ["U3", "P3"]
          },
          {
            "key": "budget_semantics",
            "name": "预算口径",
            "type": "枚举",
            "enum": ["区间", "约(单值)", "上限", "未明确"],
            "unit": null,
            "missing": "未明确",
            "required": true,
            "value_rule": "决定硬约束准入：约(单值)不得直接变成硬上限（SPEC §6）",
            "scoring": ["R1"]
          }
        ]
      },
      {
        "name": "设备",
        "scoring": ["U1", "U4"],
        "fields": [
          {
            "key": "devices",
            "name": "现有主要设备",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "逐台/逐类原样列出（如「Velmora 手机」「禾岚 安卓手机」），保留品牌脱敏名",
            "scoring": ["U1"]
          },
          {
            "key": "ecosystem",
            "name": "系统生态",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原文生态表述（如「安卓」「Velmora 封闭系统生态」）",
            "scoring": ["U1"]
          },
          {
            "key": "ecosystem_notes",
            "name": "生态备注",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "设备切换、双生态并存等原文信息（如「之前用 Velmora，最近换成安卓禾岚」）",
            "scoring": ["U3"]
          }
        ]
      },
      {
        "name": "场景",
        "scoring": ["U1", "U4", "R1"],
        "fields": [
          {
            "key": "scenes",
            "name": "场景",
            "type": "列表",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "结构化列表，每个场景为一组原子项；渲染为 场景{n}·名称/时长/频率/优先级/判定依据 行，按优先级从高到低排序",
            "item_fields": [
              {
                "key": "scene_name",
                "name": "场景{n}·名称",
                "type": "文本",
                "unit": null,
                "missing": "未提供",
                "required": true,
                "value_rule": "场景名称取原文（如「地铁通勤」「游泳」「打游戏」）",
                "scoring": ["U1"]
              },
              {
                "key": "usage_duration",
                "name": "场景{n}·使用时长",
                "type": "文本",
                "unit": null,
                "missing": "未提供",
                "required": false,
                "value_rule": "数字+单位（如「单程40分钟」「每次1小时左右」）；缺失写「未提供」，不常识补全",
                "scoring": ["U1"]
              },
              {
                "key": "usage_frequency",
                "name": "场景{n}·使用频率",
                "type": "文本",
                "unit": null,
                "missing": "未提供",
                "required": false,
                "value_rule": "如「每天」「每周3-4次」「周末」；缺失写「未提供」",
                "scoring": ["U1"]
              },
              {
                "key": "scene_priority",
                "name": "场景{n}·优先级",
                "type": "数字",
                "unit": null,
                "missing": "优先级未明确",
                "required": true,
                "value_rule": "整数，1=最高；无法排序时写「优先级未明确」",
                "scoring": ["U1", "R1"]
              },
              {
                "key": "priority_basis",
                "name": "场景{n}·优先级判定依据",
                "type": "枚举",
                "enum": ["原文明示排序", "原文主次措辞", "优先级未明确"],
                "unit": null,
                "missing": "优先级未明确",
                "required": true,
                "value_rule": "判定顺序：原文明示排序 > 原文主次措辞（主要/其次/偶尔/平时也会/核心）> 标「优先级未明确」（SPEC §6）",
                "scoring": ["U1"]
              },
              {
                "key": "scene_evidence",
                "name": "场景{n}·原文依据",
                "type": "文本",
                "unit": null,
                "missing": "未提供",
                "required": true,
                "value_rule": "支持该场景的原文片段（逐字），供 U3 幻觉抑制核查",
                "scoring": ["U3", "P3"]
              }
            ],
            "scoring": ["U1", "U4", "R1"]
          }
        ]
      },
      {
        "name": "偏好",
        "scoring": ["U2", "U3"],
        "fields": [
          {
            "key": "brand_preferences",
            "name": "品牌倾向",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "只收原文明确表达（如「偏好 Tasvin、Norvek」），逐品牌列出",
            "scoring": ["U2"]
          },
          {
            "key": "brand_avoidances",
            "name": "品牌排斥",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "scoring": ["U2"]
          },
          {
            "key": "appearance_preferences",
            "name": "外观诉求",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "逐项列出（如「浅色系」「好看的设计」），不得笼统合并",
            "scoring": ["U2"]
          },
          {
            "key": "sound_preferences",
            "name": "声音与听感偏好",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "如「对音质有一定要求」「不喜欢太轰头的低音」",
            "scoring": ["U2"]
          },
          {
            "key": "functional_preferences",
            "name": "功能与性能诉求",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "原文明确的功能诉求（如「需要降噪功能」「防水要好」「最好自带存储」「和安卓手机配合得好」「麦克风清晰」「听声辨位精准」）",
            "scoring": ["U2", "R1"]
          },
          {
            "key": "service_preferences",
            "name": "服务要求",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "只收原文说过的服务要求（保修/售后/客服等）",
            "scoring": ["U2"]
          },
          {
            "key": "other_preferences",
            "name": "其他明确偏好",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "原文明确但不适配上述子字段的偏好（如「希望性价比高一些」「希望能耐用一些」「对产品专业性要求高」「对品牌没有特别要求」）",
            "scoring": ["U2"]
          }
        ]
      }
    ]
  },
  "product": {
    "document": "product_list.md",
    "table_columns": ["字段组", "字段名", "取值"],
    "section_title": "产品编号+产品名称（如「P001 Ralun Pro」）；全部产品逐款成节，节顺序按 canonical_id 升序",
    "groups": [
      {
        "name": "基础标识",
        "scoring": ["P1", "P5"],
        "fields": [
          {
            "key": "canonical_id",
            "name": "产品编号",
            "type": "文本",
            "unit": null,
            "missing": null,
            "required": true,
            "value_rule": "三位规范形 P###（编号归一见 contracts/rules.json）；须与 recommendation.md 的产品ID完全一致",
            "scoring": ["P1", "R2"]
          },
          {
            "key": "aliases",
            "name": "编号别名",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "保留全部原始写法（如「P01」）",
            "scoring": ["P1"]
          },
          {
            "key": "product_name",
            "name": "产品名称",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "不带品牌前缀（与 recommendation.md「产品」列一致），如「Ralun Pro」「VD-140」",
            "scoring": ["P1", "R4"]
          },
          {
            "key": "brand",
            "name": "品牌",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "脱敏名原样沿用",
            "scoring": ["P1"]
          },
          {
            "key": "model",
            "name": "型号",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原样沿用；货架型号列与官网型号块写法可能不同，以官网型号为主值，差异在取值中并列登记",
            "scoring": ["P1"]
          },
          {
            "key": "category",
            "name": "产品类别/形态",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "如「骨传导游泳耳机」「颈挂式游泳播放器耳机」",
            "scoring": ["P1", "P2"]
          },
          {
            "key": "core_functions",
            "name": "核心功能",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "官网【型号】块核心功能逐项（如「Vondir 2.0+骨传导」「游泳EQ」「32GB本地存储」）",
            "scoring": ["P2"]
          },
          {
            "key": "generation",
            "name": "产品代际",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "原样（如「2024款 / Ralun Pro」「第7代技术 / 原Ralun 初版」「2017款」「Sorbik Pro第5代」）；相近型号必须分开处理",
            "scoring": ["P1"]
          },
          {
            "key": "variants",
            "name": "颜色/套餐",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "货架快照颜色/套餐列逐项",
            "scoring": ["P2"]
          },
          {
            "key": "channel_and_shop",
            "name": "平台与店铺类型",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "货架快照平台+店铺类型（如「电商平台甲 平台自营旗舰店」），价格与热度口径的一部分",
            "scoring": ["P2", "P4"]
          },
          {
            "key": "listing_title",
            "name": "商品标题（货架）",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "货架快照商品标题原样，供节标题与名称溯源",
            "scoring": ["P3"]
          }
        ]
      },
      {
        "name": "产品力",
        "scoring": ["P2", "P3", "P4", "P5"],
        "fields": [
          {
            "key": "noise_cancellation",
            "name": "降噪能力",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "区分「无主动降噪」「环境降噪/环境声模式」；宣传性降噪表述不得当事实",
            "scoring": ["P2", "P4"]
          },
          {
            "key": "call_capability",
            "name": "通话能力",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "如「陆上通话支持环境降噪，水下使用不以降噪为核心」；适用条件一并写明",
            "scoring": ["P2"]
          },
          {
            "key": "acoustic_tech",
            "name": "声学技术",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": false,
            "value_rule": "如「Vondir 2.0+骨传导」；厂商技术说明属宣传表述时按 fact_kind=宣传表述登记",
            "scoring": ["P2", "P4"]
          },
          {
            "key": "local_storage_gb",
            "name": "本地存储容量",
            "type": "数字",
            "unit": "GB",
            "missing": "未提供",
            "required": true,
            "scoring": ["P2"]
          },
          {
            "key": "audio_formats",
            "name": "支持音频格式",
            "type": "列表",
            "item_type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "逐格式列出；「部分详细格式待核验」时整体记待核验",
            "scoring": ["P2"]
          },
          {
            "key": "bluetooth",
            "name": "蓝牙能力",
            "type": "文本",
            "unit": null,
            "missing": "未提供",
            "required": true,
            "value_rule": "支持与否+版本；版本仅见渠道宣称时标注（如「蓝牙5.4（渠道宣称，待核验）」）",
            "scoring": ["P2", "P4"]
          },
          {
            "key": "bluetooth_underwater",
            "name": "蓝牙水下可用性",
